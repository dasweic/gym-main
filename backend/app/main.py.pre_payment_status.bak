# =========================================================
# GYM SETTINGS
# Public GET route; admin-only update
# =========================================================

@app.get("/settings/gym", response_model=GymSettingsResponse)
def get_gym_settings(db: Session = Depends(get_db)):
    settings = db.query(GymSettings).order_by(GymSettings.id.asc()).first()

    if settings is None:
        settings = GymSettings(gym_name="My Gym")
        db.add(settings)
        db.commit()
        db.refresh(settings)

    return settings


@app.put(
    "/settings/gym",
    response_model=GymSettingsResponse,
    dependencies=[Depends(require_admin)],
)
def update_gym_settings(
    settings_data: GymSettingsUpdate,
    db: Session = Depends(get_db),
):
    settings = db.query(GymSettings).order_by(GymSettings.id.asc()).first()

    if settings is None:
        settings = GymSettings(**settings_data.model_dump())
        db.add(settings)
    else:
        for field, value in settings_data.model_dump().items():
            setattr(settings, field, value)

    db.commit()
    db.refresh(settings)
    return settings


# =========================================================
# SUBSCRIPTIONS (ADMIN ONLY)
# =========================================================

@app.post(
    "/subscriptions",
    response_model=SubscriptionResponse,
    status_code=status.HTTP_201_CREATED,
    dependencies=[Depends(require_admin)],
)
def create_subscription(
    data: SubscriptionCreate,
    db: Session = Depends(get_db),
):
    member = db.get(Member, data.member_id)
    plan = db.get(Plan, data.plan_id)

    if member is None:
        raise HTTPException(status_code=404, detail="Member not found")

    if plan is None or not plan.is_active:
        raise HTTPException(status_code=404, detail="Active plan not found")

    end_date = data.start_date + timedelta(days=plan.duration_days)

    subscription = Subscription(
        member_id=data.member_id,
        plan_id=data.plan_id,
        start_date=data.start_date,
        end_date=end_date,
        status="active",
    )

    db.add(subscription)
    db.commit()
    db.refresh(subscription)
    return subscription


@app.get(
    "/subscriptions",
    response_model=list[SubscriptionResponse],
    dependencies=[Depends(require_admin)],
)
def list_subscriptions(db: Session = Depends(get_db)):
    today = date.today()
    subscriptions = (
        db.query(Subscription)
        .order_by(Subscription.id.desc())
        .all()
    )

    changed = False
    for subscription in subscriptions:
        if subscription.status == "active" and subscription.end_date < today:
            subscription.status = "expired"
            changed = True

    if changed:
        db.commit()

    return subscriptions


@app.get(
    "/subscriptions/expiring",
    dependencies=[Depends(require_admin)],
)
def expiring_subscriptions(
    days: int = 7,
    db: Session = Depends(get_db),
):
    if days < 1 or days > 90:
        raise HTTPException(
            status_code=422,
            detail="days must be between 1 and 90",
        )

    today = date.today()
    deadline = today + timedelta(days=days)

    subscriptions = (
        db.query(Subscription)
        .filter(
            Subscription.status == "active",
            Subscription.start_date <= today,
            Subscription.end_date >= today,
            Subscription.end_date <= deadline,
        )
        .order_by(Subscription.end_date.asc())
        .all()
    )

    return [
        {
            "subscription_id": sub.id,
            "member_id": sub.member_id,
            "plan_id": sub.plan_id,
            "start_date": sub.start_date,
            "end_date": sub.end_date,
            "days_remaining": (sub.end_date - today).days,
        }
        for sub in subscriptions
    ]


# =========================================================
# ATTENDANCE (ADMIN ONLY FOR NOW)
# =========================================================

@app.post(
    "/attendance",
    response_model=AttendanceResponse,
    status_code=status.HTTP_201_CREATED,
    dependencies=[Depends(require_admin)],
)
def check_in(
    data: AttendanceCreate,
    db: Session = Depends(get_db),
):
    member = db.get(Member, data.member_id)

    if member is None:
        raise HTTPException(status_code=404, detail="Member not found")

    today = date.today()
    active_subscription = (
        db.query(Subscription)
        .filter(
            Subscription.member_id == data.member_id,
            Subscription.status == "active",
            Subscription.start_date <= today,
            Subscription.end_date >= today,
        )
        .first()
    )

    if active_subscription is None:
        raise HTTPException(
            status_code=403,
            detail="No active membership for today",
        )

    attendance = Attendance(
        member_id=data.member_id,
        attendance_date=today,
        workout_focus=data.workout_focus,
        status="present",
    )
    db.add(attendance)

    try:
        db.commit()
        db.refresh(attendance)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="Attendance already marked for today",
        )

    return attendance


@app.get(
    "/attendance/{member_id}",
    response_model=list[AttendanceResponse],
    dependencies=[Depends(require_admin)],
)
def attendance_history(
    member_id: int,
    db: Session = Depends(get_db),
):
    if db.get(Member, member_id) is None:
        raise HTTPException(status_code=404, detail="Member not found")

    return (
        db.query(Attendance)
        .filter(Attendance.member_id == member_id)
        .order_by(Attendance.attendance_date.desc())
        .all()
    )


