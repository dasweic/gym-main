from datetime import date, timedelta
from datetime import date, timedelta

from app.api.member_portal import router as member_portal_router
from fastapi import Depends, FastAPI, HTTPException, status
from sqlalchemy import func
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session
from fastapi.middleware.cors import CORSMiddleware
from app.api.auth import require_admin, router as auth_router
from app.db.session import get_db
from app.models import (
    Attendance,
    GymSettings,
    Member,
    Payment,
    Plan,
    Subscription,
    Trainer,
    Workout,
)
from app.schemas.attendance import AttendanceCreate, AttendanceResponse
from app.schemas.gym_settings import GymSettingsResponse, GymSettingsUpdate
from app.schemas.member import MemberCreate, MemberResponse
from app.schemas.payment import PaymentCreate, PaymentResponse
from app.schemas.plan import PlanCreate, PlanResponse
from app.schemas.subscription import SubscriptionCreate, SubscriptionResponse
from app.schemas.trainer import TrainerCreate, TrainerResponse
from app.schemas.workout import WorkoutCreate, WorkoutResponse


app = FastAPI(
    title="Gym Management SaaS API",
    description="Backend API for gym owners and members",
    version="1.2.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://127.0.0.1:5500",
        "http://localhost:5500",
    ],
    allow_credentials=False,
    allow_methods=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
    allow_headers=["Authorization", "Content-Type"],
)

app.include_router(auth_router)
app.include_router(member_portal_router)


# =========================================================
# HOME & HEALTH
# =========================================================

@app.get("/")
def home():
    return {
        "message": "Gym Management SaaS API is running",
        "status": "ok",
    }


@app.get("/health")
def health_check():
    return {"status": "healthy"}


# =========================================================
# ADMIN DASHBOARD SUMMARY
# =========================================================

@app.get(
    "/dashboard/summary",
    dependencies=[Depends(require_admin)],
)
def dashboard_summary(db: Session = Depends(get_db)):
    today = date.today()
    next_seven_days = today + timedelta(days=7)

    total_members = db.query(func.count(Member.id)).scalar() or 0

    active_subscriptions = (
        db.query(func.count(Subscription.id))
        .filter(
            Subscription.status == "active",
            Subscription.start_date <= today,
            Subscription.end_date >= today,
        )
        .scalar()
        or 0
    )

    active_trainers = (
        db.query(func.count(Trainer.id))
        .filter(Trainer.is_active.is_(True))
        .scalar()
        or 0
    )

    attendance_today = (
        db.query(func.count(Attendance.id))
        .filter(
            Attendance.attendance_date == today,
            Attendance.status == "present",
        )
        .scalar()
        or 0
    )

    memberships_expiring_in_7_days = (
        db.query(func.count(Subscription.id))
        .filter(
            Subscription.status == "active",
            Subscription.end_date >= today,
            Subscription.end_date <= next_seven_days,
        )
        .scalar()
        or 0
    )

    verified_revenue = (
        db.query(func.coalesce(func.sum(Payment.amount), 0))
        .filter(Payment.status == "completed")
        .scalar()
        or 0
    )

    pending_payments = (
        db.query(func.count(Payment.id))
        .filter(Payment.status == "pending")
        .scalar()
        or 0
    )

    return {
        "total_members": total_members,
        "active_subscriptions": active_subscriptions,
        "active_trainers": active_trainers,
        "attendance_today": attendance_today,
        "memberships_expiring_in_7_days": memberships_expiring_in_7_days,
        "verified_revenue": float(verified_revenue),
        "pending_payments": pending_payments,
    }


# =========================================================
# MEMBERS (ADMIN ONLY)
# =========================================================

@app.post(
    "/members",
    response_model=MemberResponse,
    status_code=status.HTTP_201_CREATED,
    dependencies=[Depends(require_admin)],
)
def create_member(
    member_data: MemberCreate,
    db: Session = Depends(get_db),
):
    member = Member(
        name=member_data.name,
        age=member_data.age,
        phone=member_data.phone,
        photo_path=member_data.photo_path,
        height_cm=member_data.height_cm,
        weight_kg=member_data.weight_kg,
    )

    db.add(member)

    try:
        db.commit()
        db.refresh(member)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="A member with this phone number already exists.",
        )

    return member


@app.get(
    "/members",
    response_model=list[MemberResponse],
    dependencies=[Depends(require_admin)],
)
def list_members(db: Session = Depends(get_db)):
    return db.query(Member).order_by(Member.id.desc()).all()


@app.get(
    "/members/{member_id}",
    response_model=MemberResponse,
    dependencies=[Depends(require_admin)],
)
def get_member(
    member_id: int,
    db: Session = Depends(get_db),
):
    member = db.get(Member, member_id)

    if member is None:
        raise HTTPException(status_code=404, detail="Member not found")

    return member


@app.put(
    "/members/{member_id}",
    response_model=MemberResponse,
    dependencies=[Depends(require_admin)],
)
def update_member(
    member_id: int,
    member_data: MemberCreate,
    db: Session = Depends(get_db),
):
    member = db.get(Member, member_id)

    if member is None:
        raise HTTPException(status_code=404, detail="Member not found")

    member.name = member_data.name
    member.age = member_data.age
    member.phone = member_data.phone
    member.photo_path = member_data.photo_path
    member.height_cm = member_data.height_cm
    member.weight_kg = member_data.weight_kg

    try:
        db.commit()
        db.refresh(member)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="A member with this phone number already exists.",
        )

    return member


@app.delete(
    "/members/{member_id}",
    status_code=status.HTTP_204_NO_CONTENT,
    dependencies=[Depends(require_admin)],
)
def delete_member(
    member_id: int,
    db: Session = Depends(get_db),
):
    member = db.get(Member, member_id)

    if member is None:
        raise HTTPException(status_code=404, detail="Member not found")

    db.delete(member)
    db.commit()
    return None


@app.get(
    "/members/{member_id}/stats",
    dependencies=[Depends(require_admin)],
)
def member_stats(
    member_id: int,
    db: Session = Depends(get_db),
):
    member = db.get(Member, member_id)

    if member is None:
        raise HTTPException(status_code=404, detail="Member not found")

    bmi = None
    if (
        member.height_cm is not None
        and member.weight_kg is not None
        and member.height_cm > 0
        and member.weight_kg > 0
    ):
        height_m = member.height_cm / 100
        bmi = round(member.weight_kg / (height_m ** 2), 2)

    return {
        "member_id": member.id,
        "name": member.name,
        "age": member.age,
        "height_cm": member.height_cm,
        "weight_kg": member.weight_kg,
        "bmi": bmi,
    }


# =========================================================
# MEMBERSHIP PLANS
# Public GET routes; admin-only create/update/deactivate
# =========================================================

@app.post(
    "/plans",
    response_model=PlanResponse,
    status_code=status.HTTP_201_CREATED,
    dependencies=[Depends(require_admin)],
)
def create_plan(
    plan_data: PlanCreate,
    db: Session = Depends(get_db),
):
    plan = Plan(**plan_data.model_dump())
    db.add(plan)
    db.commit()
    db.refresh(plan)
    return plan


@app.get("/plans", response_model=list[PlanResponse])
def list_plans(db: Session = Depends(get_db)):
    return (
        db.query(Plan)
        .filter(Plan.is_active.is_(True))
        .order_by(Plan.id.desc())
        .all()
    )


@app.get("/plans/{plan_id}", response_model=PlanResponse)
def get_plan(
    plan_id: int,
    db: Session = Depends(get_db),
):
    plan = db.get(Plan, plan_id)

    if plan is None:
        raise HTTPException(status_code=404, detail="Membership plan not found")

    return plan


@app.put(
    "/plans/{plan_id}",
    response_model=PlanResponse,
    dependencies=[Depends(require_admin)],
)
def update_plan(
    plan_id: int,
    plan_data: PlanCreate,
    db: Session = Depends(get_db),
):
    plan = db.get(Plan, plan_id)

    if plan is None:
        raise HTTPException(status_code=404, detail="Membership plan not found")

    for field, value in plan_data.model_dump().items():
        setattr(plan, field, value)

    db.commit()
    db.refresh(plan)
    return plan


@app.patch(
    "/plans/{plan_id}/deactivate",
    response_model=PlanResponse,
    dependencies=[Depends(require_admin)],
)
def deactivate_plan(
    plan_id: int,
    db: Session = Depends(get_db),
):
    plan = db.get(Plan, plan_id)

    if plan is None:
        raise HTTPException(status_code=404, detail="Membership plan not found")

    plan.is_active = False
    db.commit()
    db.refresh(plan)
    return plan


