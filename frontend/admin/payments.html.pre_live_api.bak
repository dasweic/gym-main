  <!-- About demo dialog -->
  <div id="aboutOverlay" class="overlay hidden" role="presentation">
    <section class="modal !max-w-[450px]" role="dialog" aria-modal="true" aria-labelledby="aboutTitle" tabindex="-1">
      <div class="p-5 sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#332014] text-brand grid place-items-center"><i data-lucide="shield-check" class="w-5 h-5"></i></div>
            <div><h2 id="aboutTitle" class="font-bold text-sm">About this demo</h2><p class="text-[10px] text-neutral-500 mt-1">Payments management prototype</p></div>
          </div>
          <button class="modal-close w-8 h-8 grid place-items-center rounded-lg border border-[#333]" data-close="aboutOverlay" aria-label="Close about dialog"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="space-y-3 mt-5 text-[11px] text-neutral-400 leading-relaxed">
          <p>All transaction records, member details, dates, amounts, and sample identifiers on this page are fictional demonstration data.</p>
          <p>Payment actions update the in-memory demo dataset only. Changes are not sent to a payment provider or backend and reset on page reload.</p>
          <p>UPI settings and QR previews are temporary. The QR image stays in browser memory for this page and is not uploaded.</p>
          <p>A production FastAPI/PostgreSQL integration must verify transactions through trusted server-side provider evidence and implement authenticated, authorized, audited refund workflows.</p>
        </div>
        <button class="btn btn-primary w-full mt-5 modal-close" data-close="aboutOverlay">Got it</button>
      </div>
    </section>
  </div>

  <div id="toastRegion" class="toast-region" aria-live="polite" aria-relevant="additions text"></div>

  <script>
    "use strict";

    /*
     * PAYMENT MANAGEMENT DEMO
     *
     * Integration notes:
     * - This page intentionally does not call any API endpoints.
     * - All transaction mutations exist only in the in-memory `transactions` array.
     * - Never trust a browser-side status change as proof of payment.
     * - A future backend should authorize each action and verify provider evidence
     *   server-side, with idempotency, audit logs, and explicit refund handling.
     * - Never place API keys, provider secrets, or authentication tokens in this page.
     */

    const $ = (selector, root = document) => root.querySelector(selector);
    const $$ = (selector, root = document) => [...root.querySelectorAll(selector)];

    const rupeeFormatter = new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: "INR",
      maximumFractionDigits: 2
    });

    function money(amount) {
      return rupeeFormatter.format(Number(amount) || 0);
    }

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[character]);
    }

    function statusClass(status) {
      return ({
        "Paid": "status-paid",
        "Pending": "status-pending",
        "Failed": "status-failed",
        "Refund Pending": "status-refund-pending",
        "Refunded": "status-refunded"
      })[status] || "status-pending";
    }

    function statusBadge(status) {
      return `<span class="status ${statusClass(status)}" aria-label="Status: ${escapeHTML(status)}">${escapeHTML(status)}</span>`;
    }

    function initials(name) {
      return String(name).trim().split(/\s+/).slice(0, 2).map(part => part[0] || "").join("").toUpperCase();
    }

    const avatarColors = [
      ["#2A211A", "#FFB36F"], ["#1D2635", "#93C5FD"],
      ["#292036", "#D8B4FE"], ["#183027", "#86EFAC"],
      ["#322124", "#FDA4AF"], ["#272D32", "#A5F3FC"],
      ["#332A17", "#FDE68A"], ["#28241D", "#D6D3D1"]
    ];

    const sampleDataNotice = "This is an illustrative demo action. No real payment was verified, refunded, or transferred.";

    // All names, IDs, amounts, timestamps, and reference labels are fictional.
    // Dates are fixed to keep the demonstration predictable across page visits.
    const transactions = [
      { id: "DEMO-TXN-1001", memberId: "DEMO-M001", member: "Aarav Sharma", email: "aarav@example.invalid", plan: "Premium Annual", amount: 14999, date: "2026-10-09T10:30:00+05:30", method: "UPI", status: "Paid", reference: "ILLUSTRATIVE-REF-001" },
      { id: "DEMO-TXN-1002", memberId: "DEMO-M002", member: "Priya Patel", email: "priya@example.invalid", plan: "Standard Quarterly", amount: 4500, date: "2026-10-09T09:45:00+05:30", method: "Cash", status: "Pending", reference: "No gateway reference — cash sample" },
      { id: "DEMO-TXN-1003", memberId: "DEMO-M003", member: "Rohan Mehta", email: "rohan@example.invalid", plan: "Elite Monthly", amount: 2999, date: "2026-10-08T18:20:00+05:30", method: "Bank Transfer", status: "Paid", reference: "ILLUSTRATIVE-REF-003" },
      { id: "DEMO-TXN-1004", memberId: "DEMO-M004", member: "Ananya Singh", email: "ananya@example.invalid", plan: "Premium Annual", amount: 14999, date: "2026-10-08T16:15:00+05:30", method: "UPI", status: "Refund Pending", reference: "ILLUSTRATIVE-REF-004" },
      { id: "DEMO-TXN-1005", memberId: "DEMO-M005", member: "Kabir Verma", email: "kabir@example.invalid", plan: "Standard Monthly", amount: 1799, date: "2026-10-08T12:05:00+05:30", method: "UPI", status: "Failed", reference: "ILLUSTRATIVE-REF-005" },
      { id: "DEMO-TXN-1006", memberId: "DEMO-M006", member: "Ishita Gupta", email: "ishita@example.invalid", plan: "Elite Quarterly", amount: 7999, date: "2026-10-07T17:30:00+05:30", method: "Bank Transfer", status: "Paid", reference: "ILLUSTRATIVE-REF-006" },
      { id: "DEMO-TXN-1007", memberId: "DEMO-M007", member: "Arjun Joshi", email: "arjun@example.invalid", plan: "Standard Monthly", amount: 1799, date: "2026-10-07T14:20:00+05:30", method: "Cash", status: "Refunded", reference: "Illustrative manual refund record" },
      { id: "DEMO-TXN-1008", memberId: "DEMO-M008", member: "Meera Kapoor", email: "meera@example.invalid", plan: "Premium Quarterly", amount: 6999, date: "2026-10-06T11:50:00+05:30", method: "UPI", status: "Paid", reference: "ILLUSTRATIVE-REF-008" },
      { id: "DEMO-TXN-1009", memberId: "DEMO-M009", member: "Vivaan Reddy", email: "vivaan@example.invalid", plan: "Elite Monthly", amount: 2999, date: "2026-10-05T10:10:00+05:30", method: "Bank Transfer", status: "Pending", reference: "ILLUSTRATIVE-REF-009" },
      { id: "DEMO-TXN-1010", memberId: "DEMO-M010", member: "Diya Malhotra", email: "diya@example.invalid", plan: "Premium Annual", amount: 14999, date: "2026-10-04T15:40:00+05:30", method: "UPI", status: "Paid", reference: "ILLUSTRATIVE-REF-010" },
      { id: "DEMO-TXN-1011", memberId: "DEMO-M011", member: "Aditya Nair", email: "aditya@example.invalid", plan: "Standard Quarterly", amount: 4500, date: "2026-10-03T13:25:00+05:30", method: "Cash", status: "Paid", reference: "No gateway reference — cash sample" },
      { id: "DEMO-TXN-1012", memberId: "DEMO-M012", member: "Saanvi Rao", email: "saanvi@example.invalid", plan: "Elite Quarterly", amount: 7999, date: "2026-10-02T09:15:00+05:30", method: "UPI", status: "Failed", reference: "ILLUSTRATIVE-REF-012" },
      { id: "DEMO-TXN-1013", memberId: "DEMO-M013", member: "Reyansh Shah", email: "reyansh@example.invalid", plan: "Standard Monthly", amount: 1799, date: "2026-09-30T19:05:00+05:30", method: "Bank Transfer", status: "Paid", reference: "ILLUSTRATIVE-REF-013" },
      { id: "DEMO-TXN-1014", memberId: "DEMO-M014", member: "Aadhya Iyer", email: "aadhya@example.invalid", plan: "Premium Quarterly", amount: 6999, date: "2026-09-28T11:00:00+05:30", method: "UPI", status: "Refund Pending", reference: "ILLUSTRATIVE-REF-014" },
      { id: "DEMO-TXN-1015", memberId: "DEMO-M015", member: "Krish Bansal", email: "krish@example.invalid", plan: "Standard Monthly", amount: 1799, date: "2026-09-25T16:30:00+05:30", method: "Cash", status: "Pending", reference: "No gateway reference — cash sample" },
      { id: "DEMO-TXN-1016", memberId: "DEMO-M016", member: "Tara Desai", email: "tara@example.invalid", plan: "Premium Annual", amount: 14999, date: "2026-09-22T10:45:00+05:30", method: "UPI", status: "Paid", reference: "ILLUSTRATIVE-REF-016" },
      { id: "DEMO-TXN-1017", memberId: "DEMO-M017", member: "Dev Khanna", email: "dev@example.invalid", plan: "Elite Monthly", amount: 2999, date: "2026-09-18T12:30:00+05:30", method: "Bank Transfer", status: "Refunded", reference: "Illustrative manual refund record" },
      { id: "DEMO-TXN-1018", memberId: "DEMO-M018", member: "Myra Sethi", email: "myra@example.invalid", plan: "Standard Quarterly", amount: 4500, date: "2026-09-15T17:15:00+05:30", method: "UPI", status: "Paid", reference: "ILLUSTRATIVE-REF-018" }
    ];

    let currentPage = 1;
    let activeTransactionId = null;
    let pendingConfirmation = null;
    let lastFocusedElement = null;
    let qrObjectUrl = null;
    let pendingQrFile = null;
    let currentQrFile = null;
    let savedSessionSettings = { holder: "", upiId: "", qrFile: null };
    let isSidebarOpen = false;

    const STATUS_VALUES = ["Paid", "Pending", "Failed", "Refund Pending", "Refunded"];
    const METHOD_VALUES = ["UPI", "Cash", "Bank Transfer"];

    function getTransaction(id) {
      return transactions.find(transaction => transaction.id === id) || null;
    }

    function formatDateTime(iso) {
      const date = new Date(iso);
      if (Number.isNaN(date.getTime())) return "Invalid date";
      return new Intl.DateTimeFormat("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true,
        timeZone: "Asia/Kolkata"
      }).format(date);
    }

    function getFilteredTransactions() {
      const query = $("#searchInput").value.trim().toLowerCase();
      const status = $("#statusFilter").value;
      const method = $("#methodFilter").value;
      const from = $("#dateFrom").value;
      const to = $("#dateTo").value;

      return transactions
        .filter(transaction => {
          const matchesQuery = !query ||
            transaction.member.toLowerCase().includes(query) ||
            transaction.id.toLowerCase().includes(query);

          const transactionDate = transaction.date.slice(0, 10);
          const matchesStatus = !status || transaction.status === status;
          const matchesMethod = !method || transaction.method === method;
          const matchesFrom = !from || transactionDate >= from;
          const matchesTo = !to || transactionDate <= to;

          return matchesQuery && matchesStatus && matchesMethod && matchesFrom && matchesTo;
        })
        .sort((a, b) => new Date(b.date) - new Date(a.date));
    }

    function getFilteredAmount(records) {
      // This is a display total, not a settlement or net revenue calculation.
      return records.reduce((sum, transaction) => sum + transaction.amount, 0);
    }

    function renderKpis() {
      const paid = transactions.filter(transaction => transaction.status === "Paid");
      const refunded = transactions.filter(transaction => transaction.status === "Refunded");
      const pending = transactions.filter(transaction =>
        transaction.status === "Pending" || transaction.status === "Refund Pending"
      );

      $("#kpiCollections").textContent = money(getFilteredAmount(paid));
      $("#kpiSuccessful").textContent = paid.length.toLocaleString("en-IN");
      $("#kpiPending").textContent = pending.length.toLocaleString("en-IN");
      $("#kpiRefunds").textContent = money(getFilteredAmount(refunded));
    }

    function renderRows() {
      const filtered = getFilteredTransactions();
      const pageSize = Number($("#pageSize").value) || 10;
      const pageCount = Math.max(1, Math.ceil(filtered.length / pageSize));

      currentPage = Math.min(Math.max(1, currentPage), pageCount);

      const start = (currentPage - 1) * pageSize;
      const pageRows = filtered.slice(start, start + pageSize);

      $("#resultCount").textContent = `Showing ${filtered.length} of ${transactions.length} transactions`;
      $("#resultTotal").textContent = `${money(getFilteredAmount(filtered))} filtered amount`;
      $("#paginationInfo").textContent = filtered.length
        ? `Showing ${start + 1}–${Math.min(start + pageSize, filtered.length)} of ${filtered.length}`
        : "Showing 0–0 of 0";

      const activeFilterCount = [
        $("#statusFilter").value,
        $("#methodFilter").value,
        $("#dateFrom").value,
        $("#dateTo").value
      ].filter(Boolean).length;

      $("#filterCount").textContent = activeFilterCount;
      $("#filterCount").classList.toggle("hidden", activeFilterCount === 0);

      const empty = filtered.length === 0;
      $("#emptyState").classList.toggle("hidden", !empty);
      $(".table-scroll").classList.toggle("has-empty-state", empty);
      $("#transactionBody").innerHTML = empty ? "" : pageRows.map((transaction, index) => {
        const avatar = avatarColors[(transactions.indexOf(transaction) + 8) % avatarColors.length];
        return `
          <tr>
            <td>
              <button type="button" class="text-brand hover:text-orange-300 font-semibold text-[10px] tracking-wide text-left" data-action="details" data-id="${escapeHTML(transaction.id)}" aria-label="View details for ${escapeHTML(transaction.id)}">
                ${escapeHTML(transaction.id)}
              </button>
              <div class="text-[9px] text-neutral-600 mt-1">Sample record</div>
            </td>
            <td>
              <div class="flex items-center gap-2.5 min-w-[145px]">
                <div class="member-avatar" style="background:${avatar[0]};color:${avatar[1]}">${escapeHTML(initials(transaction.member))}</div>
                <div class="min-w-0">
                  <div class="text-[11px] font-semibold text-neutral-200">${escapeHTML(transaction.member)}</div>
                  <div class="text-[9px] text-neutral-500 mt-1">${escapeHTML(transaction.memberId)}</div>
                </div>
              </div>
            </td>
            <td><span class="text-[11px] text-neutral-300 whitespace-nowrap">${escapeHTML(transaction.plan)}</span></td>
            <td><span class="font-semibold text-[11px] whitespace-nowrap">${money(transaction.amount)}</span></td>
            <td>
              <div class="text-[10px] text-neutral-300 whitespace-nowrap">${escapeHTML(formatDateTime(transaction.date))}</div>
              <div class="text-[9px] text-neutral-600 mt-1">IST</div>
            </td>
            <td>
              <div class="flex items-center gap-1.5 whitespace-nowrap text-[10px] text-neutral-300">
                <i data-lucide="${transaction.method === "UPI" ? "smartphone" : transaction.method === "Cash" ? "banknote" : "landmark"}" class="w-3.5 h-3.5 text-neutral-500"></i>
                ${escapeHTML(transaction.method)}
              </div>
            </td>
            <td>${statusBadge(transaction.status)}</td>
            <td>
              <div class="relative flex justify-end">
                <button type="button" class="w-8 h-8 grid place-items-center rounded-lg border border-[#333] text-neutral-400 hover:text-white hover:bg-[#2A2A2A]" data-action="menu" data-id="${escapeHTML(transaction.id)}" aria-label="Actions for ${escapeHTML(transaction.id)}" aria-haspopup="true" aria-expanded="false">
                  <i data-lucide="ellipsis" class="w-4 h-4"></i>
                </button>
                <div class="menu-panel hidden" data-menu-for="${escapeHTML(transaction.id)}" role="menu">
                  <button class="menu-item" role="menuitem" data-action="details" data-id="${escapeHTML(transaction.id)}"><i data-lucide="eye" class="w-3.5 h-3.5"></i> View Details</button>
                  ${transaction.status === "Pending" || transaction.status === "Failed"
                    ? `<button class="menu-item" role="menuitem" data-action="verify" data-id="${escapeHTML(transaction.id)}"><i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Verify Payment (Demo)</button>`
                    : ""}
                  ${transaction.status !== "Pending"
                    ? `<button class="menu-item" role="menuitem" data-action="pending" data-id="${escapeHTML(transaction.id)}"><i data-lucide="clock-3" class="w-3.5 h-3.5"></i> Mark as Pending</button>`
                    : ""}
                  ${transaction.status === "Paid"
                    ? `<button class="menu-item danger" role="menuitem" data-action="refundRequest" data-id="${escapeHTML(transaction.id)}"><i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Set Refund Pending</button>`
                    : ""}
                  ${transaction.status === "Refund Pending"
                    ? `<button class="menu-item danger" role="menuitem" data-action="refunded" data-id="${escapeHTML(transaction.id)}"><i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i> Mark Refunded (Demo)</button>
                       <button class="menu-item" role="menuitem" data-action="cancelRefund" data-id="${escapeHTML(transaction.id)}"><i data-lucide="undo-2" class="w-3.5 h-3.5"></i> Cancel Refund Request</button>`
                    : ""}
                  ${transaction.status === "Refunded"
                    ? `<button class="menu-item" role="menuitem" data-action="refundRequest" data-id="${escapeHTML(transaction.id)}"><i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Set Refund Pending</button>`
                    : ""}
                </div>
              </div>
            </td>
          </tr>
        `;
      }).join("");

      renderPagination(filtered.length, pageSize, pageCount);
      if (window.lucide) window.lucide.createIcons();
    }

    function renderPagination(total, pageSize, pageCount) {
      const controls = $("#paginationControls");
      controls.innerHTML = "";

      function addButton(label, page, disabled = false, active = false, ariaLabel = label) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = `pagination-btn${active ? " active" : ""}`;
        button.disabled = disabled;
        button.textContent = label;
        button.setAttribute("aria-label", ariaLabel);
        if (active) button.setAttribute("aria-current", "page");
        button.addEventListener("click", () => {
          currentPage = page;
          closeAllMenus();
          renderRows();
        });
        controls.appendChild(button);
      }

      addButton("‹", Math.max(1, currentPage - 1), currentPage === 1, false, "Previous page");

      let pages = [];
      if (pageCount <= 5) {
        pages = Array.from({ length: pageCount }, (_, index) => index + 1);
      } else if (currentPage <= 3) {
        pages = [1, 2, 3, 4, 5];
      } else if (currentPage >= pageCount - 2) {
        pages = [pageCount - 4, pageCount - 3, pageCount - 2, pageCount - 1, pageCount];
      } else {
        pages = [currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2];
      }

      pages.forEach(page => addButton(String(page), page, false, page === currentPage, `Page ${page}`));
      addButton("›", Math.min(pageCount, currentPage + 1), currentPage === pageCount, false, "Next page");
    }

    function renderAll() {
      renderKpis();
      renderRows();
    }

    function closeAllMenus() {
      $$("[data-menu-for]").forEach(menu => menu.classList.add("hidden"));
      $$('[data-action="menu"]').forEach(button => button.setAttribute("aria-expanded", "false"));
    }

    function openDetails(id) {
      const transaction = getTransaction(id);
      if (!transaction) {
        showToast("Transaction not found in the demo dataset.", "error");
        return;
      }

      closeAllMenus();
      activeTransactionId = id;
      lastFocusedElement = document.activeElement;

      $("#detailAmount").textContent = money(transaction.amount);
      $("#detailStatus").innerHTML = statusBadge(transaction.status);
      $("#detailId").textContent = transaction.id;
      $("#detailMember").textContent = transaction.member;
      $("#detailEmail").textContent = transaction.email;
      $("#detailPlan").textContent = transaction.plan;
      $("#detailMethod").textContent = transaction.method;
      $("#detailDate").textContent = formatDateTime(transaction.date) + " IST";
      $("#detailMemberId").textContent = transaction.memberId;
      $("#detailReference").textContent = transaction.reference;

      const actionButton = $("#detailActionButton");
      if (transaction.status === "Pending" || transaction.status === "Failed") {
        actionButton.innerHTML = '<i data-lucide="shield-check" class="w-4 h-4"></i> Verify (Demo)';
        actionButton.dataset.action = "verify";
      } else if (transaction.status === "Paid") {
        actionButton.innerHTML = '<i data-lucide="rotate-ccw" class="w-4 h-4"></i> Set Refund Pending';
        actionButton.dataset.action = "refundRequest";
      } else if (transaction.status === "Refund Pending") {
        actionButton.innerHTML = '<i data-lucide="check-circle-2" class="w-4 h-4"></i> Mark Refunded (Demo)';
        actionButton.dataset.action = "refunded";
      } else {
        actionButton.innerHTML = '<i data-lucide="clock-3" class="w-4 h-4"></i> Mark as Pending';
        actionButton.dataset.action = "pending";
      }
      actionButton.dataset.id = id;

      $("#detailsOverlay").classList.remove("hidden");
      document.body.style.overflow = "hidden";
      if (window.lucide) window.lucide.createIcons();
      $("#detailsModal").focus();
    }

    function hideOverlay(overlay) {
      if (!overlay || overlay.classList.contains("hidden")) return;
      overlay.classList.add("hidden");
      const anyOpen = $$(".overlay").some(item => !item.classList.contains("hidden"));
      document.body.style.overflow = anyOpen ? "hidden" : "";
      if (!anyOpen && lastFocusedElement && typeof lastFocusedElement.focus === "function") {
        lastFocusedElement.focus();
      }
    }

    function showToast(message, type = "info", title = "") {
      const region = $("#toastRegion");
      const toast = document.createElement("div");
      toast.className = `toast ${type}`;
      const icon = type === "success" ? "check-circle-2" : type === "error" ? "alert-circle" : "info";
      const heading = title || (type === "success" ? "Demo update complete" : type === "error" ? "Please check" : "Demo notice");

      toast.innerHTML = `
        <i data-lucide="${icon}" class="w-4 h-4 mt-0.5 flex-shrink-0 ${type === "success" ? "text-emerald-400" : type === "error" ? "text-red-400" : "text-[#F9B477]"}"></i>
        <div class="min-w-0 flex-1">
          <div class="text-[11px] font-semibold text-white">${escapeHTML(heading)}</div>
          <div class="text-[10px] text-neutral-400 mt-1 leading-relaxed">${escapeHTML(message)}</div>
        </div>
        <button type="button" class="text-neutral-500 hover:text-white" aria-label="Dismiss notification"><i data-lucide="x" class="w-3.5 h-3.5"></i></button>
      `;

      toast.querySelector("button").addEventListener("click", () => toast.remove());
      region.appendChild(toast);
      if (window.lucide) window.lucide.createIcons();

      // Keep notifications available long enough to read; they never control transactions.
      window.setTimeout(() => {
        if (toast.isConnected) toast.remove();
      }, 6000);
    }

    function actionDescription(action, transaction) {
      const details = {
        verify: {
          title: "Simulate payment verification?",
          description: `Change ${transaction.id} (${transaction.member}) to Paid in the local demo dataset? This is not real payment verification.`,
          next: "Paid"
        },
        pending: {
          title: "Mark this record as pending?",
          description: `Set ${transaction.id} to Pending in the local demo dataset?`,
          next: "Pending"
        },
        refundRequest: {
          title: "Set refund status to pending?",
          description: `Change ${transaction.id} to Refund Pending in the local demo dataset. No refund will be requested from a provider.`,
          next: "Refund Pending"
        },
        refunded: {
          title: "Mark as refunded in the demo?",
          description: `Change ${transaction.id} to Refunded in the local demo dataset? This does not send money or confirm an actual refund.`,
          next: "Refunded"
        },
        cancelRefund: {
          title: "Cancel the demo refund request?",
          description: `Return ${transaction.id} from Refund Pending to Paid in the local demo dataset?`,
          next: "Paid"
        }
      };
      return details[action] || null;
    }

    function requestAction(action, id) {
      const transaction = getTransaction(id);
      if (!transaction) {
        showToast("Transaction not found.", "error");
        return;
      }

      const config = actionDescription(action, transaction);
      if (!config) return;

      // Avoid offering invalid transitions if the row was updated elsewhere.
      const validTransitions = {
        verify: ["Pending", "Failed"],
        pending: STATUS_VALUES.filter(status => status !== "Pending"),
        refundRequest: ["Paid", "Refunded"],
        refunded: ["Refund Pending"],
        cancelRefund: ["Refund Pending"]
      };

      if (!validTransitions[action]?.includes(transaction.status)) {
        showToast("This action is not available for the current demo status.", "error");
        return;
      }

      closeAllMenus();
      pendingConfirmation = { action, id, expectedStatus: transaction.status };
      lastFocusedElement = document.activeElement;

      $("#confirmTitle").textContent = config.title;
      $("#confirmDescription").textContent = config.description;
      $("#acceptConfirm").disabled = false;
      $("#acceptConfirm").textContent = "Confirm demo change";
      $("#confirmOverlay").classList.remove("hidden");
      document.body.style.overflow = "hidden";
      $(".modal[role='alertdialog']", $("#confirmOverlay")).focus();
    }

    function performConfirmedAction() {
      if (!pendingConfirmation) return;

      const { action, id, expectedStatus } = pendingConfirmation;
      const transaction = getTransaction(id);

      if (!transaction || transaction.status !== expectedStatus) {
        pendingConfirmation = null;
        hideOverlay($("#confirmOverlay"));
        showToast("The sample record changed. Review its current status and try again.", "error");
        return;
      }

      const config = actionDescription(action, transaction);
      if (!config) return;

      // Intentionally an in-memory demo mutation; never a real financial operation.
      transaction.status = config.next;
      pendingConfirmation = null;
      hideOverlay($("#confirmOverlay"));

      renderAll();

      if (activeTransactionId === id && !$("#detailsOverlay").classList.contains("hidden")) {
        openDetails(id);
      }

      showToast(`${id} is now marked "${config.next}" in the demonstration dataset. ${sampleDataNotice}`, "success");
    }

    // CSV uses the entire currently filtered result, not only the visible page.
    function csvEscape(value) {
      const text = String(value ?? "");
      return /[",\r\n]/.test(text) ? '"' + text.replace(/"/g, '""') + '"' : text;
    }

    function exportCsv() {
      const rows = getFilteredTransactions();
      if (rows.length === 0) {
        showToast("There are no filtered sample transactions to export.", "error");
        return;
      }

      const headers = [
        "Transaction ID",
        "Member ID",
        "Member Name",
        "Member Email",
        "Membership Plan",
        "Amount INR",
        "Date Time IST",
        "Payment Method",
        "Status",
        "Reference Information",
        "Record Type"
      ];

      const csvRows = rows.map(transaction => [
        transaction.id,
        transaction.memberId,
        transaction.member,
        transaction.email,
        transaction.plan,
        transaction.amount.toFixed(2),
        formatDateTime(transaction.date) + " IST",
        transaction.method,
        transaction.status,
        transaction.reference,
        "Illustrative sample data"
      ]);

      const csv = "\uFEFF" + [headers, ...csvRows]
        .map(row => row.map(csvEscape).join(","))
        .join("\r\n");

      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      const dateStamp = new Date().toISOString().slice(0, 10);
      link.href = url;
      link.download = `ironcore-demo-transactions-${dateStamp}.csv`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);

      showToast(`Exported ${rows.length} filtered illustrative transaction(s). This CSV contains demo data only.`, "success");
    }

    // Search and filters
    $("#searchInput").addEventListener("input", () => {
      currentPage = 1;
      closeAllMenus();
      renderRows();
    });

    ["statusFilter", "methodFilter", "dateFrom", "dateTo"].forEach(id => {
      $("#" + id).addEventListener("change", () => {
        currentPage = 1;
        validateDateRange();
        renderRows();
      });
    });

    $("#pageSize").addEventListener("change", () => {
      currentPage = 1;
      renderRows();
    });

    function validateDateRange() {
      const from = $("#dateFrom").value;
      const to = $("#dateTo").value;
      const error = $("#dateFilterError");

      if (from && to && from > to) {
        error.textContent = "The start date must be on or before the end date. No records match this invalid range.";
        error.classList.remove("hidden");
        $("#dateFrom").setAttribute("aria-invalid", "true");
        $("#dateTo").setAttribute("aria-invalid", "true");
        return false;
      }

      error.textContent = "";
      error.classList.add("hidden");
      $("#dateFrom").removeAttribute("aria-invalid");
      $("#dateTo").removeAttribute("aria-invalid");
      return true;
    }

    $("#toggleFilters").addEventListener("click", () => {
      const panel = $("#filterPanel");
      const hidden = panel.classList.toggle("hidden");
      $("#toggleFilters").setAttribute("aria-expanded", String(!hidden));
    });

    function clearFilters() {
      $("#searchInput").value = "";
      $("#statusFilter").value = "";
      $("#methodFilter").value = "";
      $("#dateFrom").value = "";
      $("#dateTo").value = "";
      $("#dateFilterError").classList.add("hidden");
      $("#dateFrom").removeAttribute("aria-invalid");
      $("#dateTo").removeAttribute("aria-invalid");
      currentPage = 1;
      closeAllMenus();
      renderRows();
      showToast("All transaction search and filters have been cleared.", "info");
    }

    $("#clearFilters").addEventListener("click", clearFilters);
    $("#emptyClearFilters").addEventListener("click", clearFilters);
    $("#exportCsv").addEventListener("click", exportCsv);
    $("#exportFiltered").addEventListener("click", exportCsv);

    // Transaction actions use delegated event handling so pagination remains functional.
    $("#transactionBody").addEventListener("click", event => {
      const button = event.target.closest("[data-action]");
      if (!button) return;

      const { action, id } = button.dataset;

      if (action === "menu") {
        const menu = $(`[data-menu-for="${CSS.escape(id)}"]`);
        const willOpen = menu.classList.contains("hidden");
        closeAllMenus();
        if (willOpen) {
          menu.classList.remove("hidden");
          button.setAttribute("aria-expanded", "true");
        }
        return;
      }

      if (action === "details") {
        openDetails(id);
        return;
      }

      requestAction(action, id);
    });

    $("#detailActionButton").addEventListener("click", event => {
      const { action, id } = event.currentTarget.dataset;
      if (action && id) requestAction(action, id);
    });

    document.addEventListener("click", event => {
      if (!event.target.closest("[data-menu-for]") && !event.target.closest('[data-action="menu"]')) {
        closeAllMenus();
      }
    });

    // Accessible dialog handling, Escape-to-close, and focus containment.
    function openSimpleOverlay(overlay) {
      lastFocusedElement = document.activeElement;
      overlay.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      const dialog = $(".modal", overlay);
      if (dialog) dialog.focus();
    }

    $$("[data-close]").forEach(button => {
      button.addEventListener("click", () => {
        const overlay = $("#" + button.dataset.close);
        if (overlay === $("#confirmOverlay")) pendingConfirmation = null;
        hideOverlay(overlay);
      });
    });

    [$("#detailsOverlay"), $("#confirmOverlay"), $("#aboutOverlay")].forEach(overlay => {
      overlay.addEventListener("mousedown", event => {
        if (event.target === overlay) {
          if (overlay === $("#confirmOverlay")) pendingConfirmation = null;
          hideOverlay(overlay);
        }
      });
    });

    $("#cancelConfirm").addEventListener("click", () => {
      pendingConfirmation = null;
      hideOverlay($("#confirmOverlay"));
    });

    $("#acceptConfirm").addEventListener("click", performConfirmedAction);
    $("#topHelp").addEventListener("click", () => openSimpleOverlay($("#aboutOverlay")));

    document.addEventListener("keydown", event => {
      const visibleOverlay = $$(".overlay").find(overlay => !overlay.classList.contains("hidden"));

      if (event.key === "Escape") {
        if (visibleOverlay) {
          if (visibleOverlay === $("#confirmOverlay")) pendingConfirmation = null;
          hideOverlay(visibleOverlay);
        } else {
          closeAllMenus();
          closeSidebar();
        }
      }

      if (event.key === "Tab" && visibleOverlay) {
        const focusable = $$(
          'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href], [tabindex="0"]',
          visibleOverlay
        ).filter(element => element.offsetParent !== null);

        if (!focusable.length) {
          event.preventDefault();
          return;
        }

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // UPI form: session-memory only, no persistence or network requests.
    function setFieldError(field, errorElement, message) {
      const input = $("#" + field);
      const error = $("#" + errorElement);
      error.textContent = message;
      error.classList.toggle("hidden", !message);
      input.setAttribute("aria-invalid", String(Boolean(message)));
    }

    function validateUpiForm() {
      const holder = $("#accountHolder").value.trim();
      const upi = $("#upiId").value.trim();
      let valid = true;

      if (!holder) {
        setFieldError("accountHolder", "holderError", "Enter an account holder or gym name.");
        valid = false;
      } else {
        setFieldError("accountHolder", "holderError", "");
      }

      // Structural format check only; this cannot verify UPI ownership or validity.
      const upiPattern = /^[A-Za-z0-9][A-Za-z0-9._-]{1,99}@[A-Za-z][A-Za-z0-9.-]{1,49}$/;
      if (!upi) {
        setFieldError("upiId", "upiError", "Enter a UPI ID for this demo.");
        valid = false;
      } else if (!upiPattern.test(upi)) {
        setFieldError("upiId", "upiError", "Enter a structurally valid UPI ID, such as name@bank. Ownership is not verified.");
        valid = false;
      } else {
        setFieldError("upiId", "upiError", "");
      }

      if (!validateQrSelection()) valid = false;
      return valid;
    }

    function showSettingsFeedback(message, type) {
      const feedback = $("#settingsFeedback");
      feedback.className = "mt-4 rounded-lg p-3 text-[11px]";
      feedback.classList.add(type === "success"
        ? "bg-[#10251D] border border-[#23513C] text-emerald-300"
        : type === "error"
          ? "bg-[#2B1515] border border-[#663232] text-red-300"
          : "bg-[#211A12] border border-[#49331E] text-[#F9B477]");
      feedback.textContent = message;
    }

    function validateQrSelection() {
      if (pendingQrFile && !isValidQrFile(pendingQrFile)) {
        $("#qrError").textContent = "Choose a valid PNG, JPEG, or WebP image under 2 MB.";
        $("#qrError").classList.remove("hidden");
        return false;
      }
      $("#qrError").textContent = "";
      $("#qrError").classList.add("hidden");
      return true;
    }

    function isValidQrFile(file) {
      if (!file || file.size <= 0 || file.size > 2 * 1024 * 1024) return false;
      return ["image/png", "image/jpeg", "image/webp"].includes(file.type);
    }

    function releaseQrObjectUrl() {
      if (qrObjectUrl) {
        URL.revokeObjectURL(qrObjectUrl);
        qrObjectUrl = null;
      }
    }

    function setQrPreview(file) {
      releaseQrObjectUrl();
      currentQrFile = file || null;

      const preview = $("#qrPreview");
      const placeholder = $("#qrPlaceholder");
      const caption = $("#qrPreviewCaption");
      const fileState = $("#qrFileState");
      const removeButton = $("#removeQr");

      if (!file) {
        preview.removeAttribute("src");
        preview.classList.add("hidden");
        placeholder.classList.remove("hidden");
        caption.textContent = "Your QR code will appear here.";
        fileState.textContent = "No image selected";
        removeButton.disabled = true;
        return;
      }

      qrObjectUrl = URL.createObjectURL(file);
      preview.src = qrObjectUrl;
      preview.classList.remove("hidden");
      placeholder.classList.add("hidden");
      caption.textContent = "Local preview only. No payment scan or transfer is initiated.";
      fileState.textContent = file.name.length > 20 ? file.name.slice(0, 17) + "..." : file.name;
      removeButton.disabled = false;
    }

    function selectQrFile(file) {
      if (!file) return;

      if (!isValidQrFile(file)) {
        pendingQrFile = null;
        $("#qrFile").value = "";
        $("#qrError").textContent = "The image must be PNG, JPEG, or WebP and no larger than 2 MB.";
        $("#qrError").classList.remove("hidden");
        showToast("QR image rejected. Choose a supported image under 2 MB.", "error");
        return;
      }

      pendingQrFile = file;
      setQrPreview(file);
      $("#qrError").textContent = "";
      $("#qrError").classList.add("hidden");
      $("#settingsFeedback").classList.add("hidden");
      showToast("QR image preview updated in this page's memory.", "success");
    }

    $("#qrFile").addEventListener("change", event => {
      selectQrFile(event.target.files?.[0]);
    });

    $("#replaceQr").addEventListener("click", () => $("#qrFile").click());

    $("#removeQr").addEventListener("click", () => {
      pendingQrFile = null;
      currentQrFile = null;
      $("#qrFile").value = "";
      setQrPreview(null);
      $("#qrError").classList.add("hidden");
      $("#settingsFeedback").classList.add("hidden");
      showToast("QR image removed from the current page preview.", "info");
    });

    const qrDrop = $("#qrDrop");
    qrDrop.addEventListener("dragover", event => {
      event.preventDefault();
      qrDrop.classList.add("drag-over");
    });
    qrDrop.addEventListener("dragleave", event => {
      if (!qrDrop.contains(event.relatedTarget)) qrDrop.classList.remove("drag-over");
    });
    qrDrop.addEventListener("drop", event => {
      event.preventDefault();
      qrDrop.classList.remove("drag-over");
      selectQrFile(event.dataTransfer?.files?.[0]);
    });

    $("#accountHolder").addEventListener("input", () => {
      setFieldError("accountHolder", "holderError", "");
      $("#settingsFeedback").classList.add("hidden");
    });
    $("#upiId").addEventListener("input", () => {
      setFieldError("upiId", "upiError", "");
      $("#settingsFeedback").classList.add("hidden");
    });

    $("#upiForm").addEventListener("submit", event => {
      event.preventDefault();
      const button = $("#saveSettings");

      if (!validateUpiForm()) {
        showSettingsFeedback("Please correct the highlighted fields before saving these demo settings.", "error");
        const invalid = $("#upiForm [aria-invalid='true']");
        if (invalid) invalid.focus();
        return;
      }

      button.disabled = true;
      button.innerHTML = '<i data-lucide="loader-circle" class="w-4 h-4 animate-spin"></i> Updating demo...';
      if (window.lucide) window.lucide.createIcons();

      // The async boundary is purely for demo feedback. No network request is made.
      window.setTimeout(() => {
        savedSessionSettings = {
          holder: $("#accountHolder").value.trim(),
          upiId: $("#upiId").value.trim(),
          qrFile: currentQrFile
        };

        button.disabled = false;
        button.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Save Settings';
        if (window.lucide) window.lucide.createIcons();

        showSettingsFeedback(
          "Demo settings updated in current page memory only. Nothing was uploaded or permanently saved, and the UPI ID has not been verified.",
          "success"
        );
        showToast("UPI settings updated in page memory only. They will be lost on reload.", "success");
      }, 350);
    });

    // Responsive sidebar
    function openSidebar() {
      isSidebarOpen = true;
      $("#sidebar").classList.add("open");
      $("#sidebarBackdrop").classList.remove("hidden");
      $("#openSidebar").setAttribute("aria-expanded", "true");
      $("#closeSidebar").focus();
    }

    function closeSidebar() {
      if (!isSidebarOpen) return;
      isSidebarOpen = false;
      $("#sidebar").classList.remove("open");
      $("#sidebarBackdrop").classList.add("hidden");
      $("#openSidebar").setAttribute("aria-expanded", "false");
    }

    $("#openSidebar").addEventListener("click", openSidebar);
    $("#closeSidebar").addEventListener("click", closeSidebar);
    $("#sidebarBackdrop").addEventListener("click", closeSidebar);

    $("#scrollToSettings").addEventListener("click", () => {
      $("#upiSettings").scrollIntoView({ behavior: "smooth", block: "start" });
      window.setTimeout(() => $("#accountHolder").focus({ preventScroll: true }), 350);
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 850) closeSidebar();
    });

    window.addEventListener("beforeunload", () => {
      releaseQrObjectUrl();
    });

    // Initialize with the illustrative dataset. No external data is loaded.
    $("#currentYear").textContent = new Date().getFullYear();
    renderAll();
    if (window.lucide) window.lucide.createIcons();

    // Explicit demo initialization message.
    showToast("Loaded illustrative transactions. All actions remain local to this page.", "info", "Demo mode active");
  </script>
</body>
</html>