
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0A0A0A" />
  <meta name="description" content="Gym management payment dashboard for reviewing illustrative transactions, configuring UPI settings, and exporting payment reports." />
  <title>Payments | IronCore Admin</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: "#FF6B00",
            base: "#0A0A0A",
            panel: "#171717",
            muted: "#A3A3A3"
          },
          fontFamily: {
            sans: ["Inter", "sans-serif"],
            heading: ["Oswald", "sans-serif"]
          }
        }
      }
    };
  </script>

  <style>
    :root {
      color-scheme: dark;
      --bg: #0A0A0A;
      --panel: #171717;
      --panel2: #1D1D1D;
      --border: #2B2B2B;
      --orange: #FF6B00;
      --text: #FFFFFF;
      --muted: #A3A3A3;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Inter, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    button, input, select, textarea { font: inherit; }
    button:focus-visible, input:focus-visible, select:focus-visible,
    textarea:focus-visible, a:focus-visible {
      outline: 2px solid var(--orange);
      outline-offset: 3px;
    }

    .heading-font { font-family: Oswald, sans-serif; }
    .panel { background: var(--panel); border: 1px solid var(--border); border-radius: 15px; }
    .field {
      width: 100%;
      min-height: 42px;
      background: #101010;
      border: 1px solid #333;
      color: white;
      border-radius: 9px;
      padding: 10px 12px;
      font-size: 12px;
      transition: border-color .2s;
    }
    .field:focus { border-color: var(--orange); outline: none; }
    .field::placeholder { color: #737373; }
    select.field { cursor: pointer; }
    .field-label {
      display: block;
      font-size: 11px;
      color: #C5C5C5;
      font-weight: 600;
      margin-bottom: 7px;
    }
    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      border: 1px solid transparent;
      border-radius: 9px;
      padding: 10px 14px;
      font-size: 12px;
      font-weight: 600;
      transition: background .2s, border-color .2s, transform .2s;
      cursor: pointer;
      white-space: nowrap;
    }
    .btn:active { transform: scale(.98); }
    .btn-primary { background: var(--orange); color: white; }
    .btn-primary:hover { background: #E65F00; }
    .btn-secondary { background: #222; border-color: #373737; color: #E5E5E5; }
    .btn-secondary:hover { background: #2A2A2A; }
    .btn-danger { background: #291414; border-color: #542424; color: #FCA5A5; }
    .btn-danger:hover { background: #3A1919; }
    .btn-ghost { color: #BDBDBD; background: transparent; }
    .btn-ghost:hover { color: white; background: #292929; }
    .btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }

    .sidebar {
      width: 250px;
      position: fixed;
      inset: 0 auto 0 0;
      background: #111;
      border-right: 1px solid #292929;
      z-index: 50;
      display: flex;
      flex-direction: column;
      transition: transform .25s ease;
    }
    .sidebar-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 13px;
      margin-bottom: 4px;
      border-radius: 9px;
      color: #A3A3A3;
      text-decoration: none;
      font-size: 12px;
      font-weight: 500;
      transition: all .2s;
    }
    .sidebar-link:hover { background: #202020; color: white; }
    .sidebar-link.active {
      background: rgba(255,107,0,.12);
      color: #FF8A3D;
      border: 1px solid rgba(255,107,0,.18);
    }
    .main-content { margin-left: 250px; min-height: 100vh; }
    .topbar {
      height: 70px;
      background: rgba(10,10,10,.92);
      border-bottom: 1px solid #242424;
      position: sticky;
      top: 0;
      z-index: 30;
      backdrop-filter: blur(16px);
    }
    .kpi-card { padding: 19px; min-width: 0; }
    .kpi-icon {
      width: 39px;
      height: 39px;
      display: grid;
      place-items: center;
      border-radius: 11px;
    }
    .kpi-value { font-size: clamp(22px, 2vw, 29px); font-weight: 700; letter-spacing: -1.1px; }
    .muted { color: var(--muted); }
    .section-title { font-size: 14px; font-weight: 700; }
    .eyebrow { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 700; color: #8F8F8F; }
    .sample-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 8px;
      border-radius: 6px;
      background: #21190F;
      border: 1px solid #49301B;
      color: #F9B477;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .35px;
    }
    .status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      padding: 5px 8px;
      border: 1px solid transparent;
      border-radius: 6px;
      font-size: 10px;
      line-height: 1.2;
      font-weight: 600;
    }
    .status::before {
      content: "";
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }
    .status-paid, .status-refunded { color: #6EE7B7; background: #10251D; border-color: #1E4836; }
    .status-pending, .status-refund-pending { color: #FCD34D; background: #29220E; border-color: #4C3C14; }
    .status-failed { color: #FCA5A5; background: #2B1515; border-color: #502525; }

    .table-scroll { overflow-x: auto; }
    .transaction-table { width: 100%; border-collapse: collapse; text-align: left; }
    .transaction-table th {
      padding: 13px 15px;
      background: #1B1B1B;
      color: #858585;
      font-size: 9px;
      letter-spacing: .7px;
      text-transform: uppercase;
      font-weight: 700;
      white-space: nowrap;
    }
    .transaction-table td {
      padding: 15px;
      border-bottom: 1px solid #292929;
      font-size: 11px;
      vertical-align: middle;
    }
    .transaction-table tbody tr { transition: background .15s; }
    .transaction-table tbody tr:hover { background: #1D1D1D; }
    .transaction-table tbody tr:last-child td { border-bottom: none; }
    .transaction-table td:first-child, .transaction-table th:first-child { padding-left: 19px; }
    .transaction-table td:last-child, .transaction-table th:last-child { padding-right: 19px; }
    .member-avatar {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      font-size: 10px;
      font-weight: 700;
      flex-shrink: 0;
    }
    .menu-panel {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      z-index: 20;
      min-width: 175px;
      padding: 5px;
      border: 1px solid #383838;
      background: #202020;
      border-radius: 10px;
      box-shadow: 0 12px 35px #0009;
    }
    .menu-item {
      width: 100%;
      padding: 9px 10px;
      display: flex;
      align-items: center;
      gap: 9px;
      text-align: left;
      color: #D4D4D4;
      font-size: 11px;
      border-radius: 6px;
      background: transparent;
      cursor: pointer;
    }
    .menu-item:hover { background: #303030; color: white; }
    .menu-item.danger { color: #FCA5A5; }
    .menu-item:disabled { opacity: .4; cursor: not-allowed; }

    .qr-drop {
      border: 1px dashed #484848;
      background: #101010;
      border-radius: 12px;
      transition: border-color .2s, background .2s;
    }
    .qr-drop.drag-over { border-color: var(--orange); background: #21180F; }
    .qr-preview {
      width: 138px;
      height: 138px;
      border: 1px solid #373737;
      background: white;
      border-radius: 9px;
      object-fit: contain;
      padding: 7px;
    }
    .qr-placeholder {
      width: 138px;
      height: 138px;
      border: 1px solid #333;
      background: #101010;
      border-radius: 9px;
      display: grid;
      place-items: center;
      color: #696969;
    }

    .overlay {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0,0,0,.78);
      backdrop-filter: blur(5px);
    }
    .modal {
      width: min(100%, 600px);
      max-height: min(88vh, 850px);
      overflow-y: auto;
      background: #171717;
      border: 1px solid #353535;
      border-radius: 16px;
      box-shadow: 0 24px 90px #0009;
      animation: modal-in .18s ease-out;
    }
    .modal-wide { width: min(100%, 760px); }
    @keyframes modal-in {
      from { opacity: 0; transform: translateY(8px) scale(.99); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .detail-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .detail-item { background: #111; border: 1px solid #292929; border-radius: 9px; padding: 12px; min-width: 0; }
    .detail-label { color: #8C8C8C; font-size: 10px; margin-bottom: 7px; }
    .detail-value { font-size: 12px; color: #F3F3F3; font-weight: 600; overflow-wrap: anywhere; }
    .toast-region {
      position: fixed;
      top: 84px;
      right: 20px;
      z-index: 200;
      width: min(380px, calc(100vw - 32px));
      display: grid;
      gap: 8px;
      pointer-events: none;
    }
    .toast {
      background: #1B1B1B;
      border: 1px solid #383838;
      border-radius: 11px;
      padding: 13px 15px;
      display: flex;
      gap: 11px;
      align-items: flex-start;
      box-shadow: 0 8px 30px #0007;
      animation: toast-in .2s ease-out;
      pointer-events: auto;
    }
    .toast.success { border-color: #23513C; }
    .toast.error { border-color: #663232; }
    .toast.info { border-color: #49371D; }
    @keyframes toast-in { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

    .empty-state { padding: 48px 20px; text-align: center; }
    .empty-icon { width: 48px; height: 48px; margin: 0 auto 14px; display: grid; place-items: center; border-radius: 14px; background: #252525; color: #A3A3A3; }
    .pagination-btn {
      min-width: 29px;
      height: 29px;
      border: 1px solid #333;
      border-radius: 7px;
      display: grid;
      place-items: center;
      color: #A3A3A3;
      font-size: 11px;
      background: #151515;
    }
    .pagination-btn.active { background: #FF6B00; color: white; border-color: #FF6B00; }
    .pagination-btn:disabled { opacity: .35; cursor: not-allowed; }
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
    .hidden { display: none !important; }

    @media (max-width: 1100px) {
      .sidebar { width: 225px; }
      .main-content { margin-left: 225px; }
      .transaction-table th, .transaction-table td { padding-left: 11px; padding-right: 11px; }
      .kpi-card { padding: 15px; }
    }
    @media (max-width: 850px) {
      .sidebar { transform: translateX(-100%); width: 260px; }
      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; }
      .sidebar-backdrop {
        position: fixed; inset: 0; z-index: 45; background: #0009;
      }
      .kpi-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
      .filters-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    }
    @media (max-width: 520px) {
      .page-container { padding: 18px 13px !important; }
      .topbar { height: 62px; padding-left: 13px !important; padding-right: 13px !important; }
      .kpi-grid { gap: 10px; }
      .kpi-card { padding: 13px; }
      .kpi-icon { width: 33px; height: 33px; }
      .kpi-value { font-size: 22px; }
      .heading-font.page-title { font-size: 28px; }
      .filters-grid { grid-template-columns: 1fr; }
      .detail-grid { grid-template-columns: 1fr 1fr; }
      .overlay { padding: 10px; }
      .modal { border-radius: 13px; }
      .toast-region { top: 70px; right: 10px; width: calc(100vw - 20px); }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
    }
  </style>
</head>

<body>
  <div id="sidebarBackdrop" class="sidebar-backdrop hidden" aria-hidden="true"></div>

  <aside id="sidebar" class="sidebar" aria-label="Main navigation">
    <div class="h-[70px] px-6 flex items-center gap-3 border-b border-[#292929]">
      <div class="w-10 h-10 rounded-xl bg-brand flex items-center justify-center text-white">
        <i data-lucide="dumbbell" class="w-5 h-5"></i>
      </div>
      <div>
        <div class="heading-font text-[22px] tracking-wide leading-none">IRON<span class="text-brand">CORE</span></div>
        <div class="text-[9px] text-neutral-500 tracking-[2px] mt-1">GYM MANAGEMENT</div>
      </div>
      <button id="closeSidebar" class="ml-auto md:hidden text-neutral-400 hover:text-white" aria-label="Close navigation">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <div class="px-4 pt-7 pb-2">
      <div class="eyebrow px-3 mb-3">Workspace</div>
      <nav>
        <a href="dashboard.html" class="sidebar-link">
          <i data-lucide="layout-dashboard" class="w-[17px] h-[17px]"></i>
          <span>Dashboard</span>
        </a>
        <a href="members.html" class="sidebar-link">
          <i data-lucide="users" class="w-[17px] h-[17px]"></i>
          <span>Members</span>
        </a>
        <a href="payments.html" class="sidebar-link active" aria-current="page">
          <i data-lucide="wallet" class="w-[17px] h-[17px]"></i>
          <span>Payments</span>
          <span class="ml-auto w-1.5 h-1.5 rounded-full bg-brand"></span>
        </a>
        <a href="plans.html" class="sidebar-link">
          <i data-lucide="layers" class="w-[17px] h-[17px]"></i>
          <span>Membership Plans</span>
        </a>
        <a href="trainers.html" class="sidebar-link">
          <i data-lucide="user-round-check" class="w-[17px] h-[17px]"></i>
          <span>Trainers</span>
        </a>
      </nav>

      <div class="eyebrow px-3 mt-8 mb-3">Preferences</div>
      <nav>
        <a href="settings.html" class="sidebar-link">
          <i data-lucide="settings-2" class="w-[17px] h-[17px]"></i>
          <span>Settings</span>
        </a>
      </nav>
    </div>

    <div class="mt-auto p-4">
      <div class="rounded-xl border border-[#333] bg-[#191919] p-4">
        <div class="flex items-center gap-2 mb-2">
          <i data-lucide="shield-check" class="w-4 h-4 text-brand"></i>
          <span class="text-[11px] font-semibold">Demo environment</span>
        </div>
        <p class="text-[10px] text-neutral-500 leading-relaxed">Illustrative data only. No live payment gateway is connected.</p>
      </div>
      <div class="flex items-center gap-3 mt-4 px-1">
        <div class="w-9 h-9 rounded-full bg-[#33251A] border border-[#56381F] grid place-items-center text-brand text-xs font-bold">AD</div>
        <div class="min-w-0">
          <div class="text-xs font-semibold">Gym Administrator</div>
          <div class="text-[10px] text-neutral-500 mt-1">Owner workspace</div>
        </div>
        <span class="ml-auto w-2 h-2 rounded-full bg-emerald-400" title="Demo UI available"></span>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <header class="topbar px-6 lg:px-8 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 min-w-0">
        <button id="openSidebar" class="md:hidden w-9 h-9 rounded-lg border border-[#333] grid place-items-center text-neutral-300" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
          <i data-lucide="menu" class="w-5 h-5"></i>
        </button>
        <div class="text-[11px] text-neutral-500 hidden sm:flex items-center gap-2">
          <i data-lucide="house" class="w-3.5 h-3.5"></i>
          <span>/</span>
          <span>Admin</span>
          <span>/</span>
          <span class="text-neutral-200">Payments</span>
        </div>
        <div class="sm:hidden text-sm font-semibold">Payments</div>
      </div>
      <div class="flex items-center gap-3">
        <span class="hidden sm:inline-flex sample-label">
          <i data-lucide="flask-conical" class="w-3 h-3"></i>
          SAMPLE DATA
        </span>
        <button id="topHelp" class="w-9 h-9 rounded-lg border border-[#333] grid place-items-center text-neutral-400 hover:text-white hover:bg-[#222]" aria-label="About this demo" title="About this demo">
          <i data-lucide="info" class="w-4 h-4"></i>
        </button>
        <div class="w-9 h-9 rounded-full bg-[#302218] border border-[#51351F] grid place-items-center text-brand text-xs font-bold">AD</div>
      </div>
    </header>

    <div class="page-container px-6 py-7 lg:px-8 lg:py-8 max-w-[1700px] mx-auto">
      <section class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-7">
        <div>
          <div class="eyebrow mb-2">Finance / Overview</div>
          <h1 class="heading-font page-title text-[34px] sm:text-[38px] tracking-wide leading-tight">Payment Management<span class="text-brand">.</span></h1>
          <p class="text-xs text-neutral-500 mt-2">Track collections, review transactions, and configure your payment preferences.</p>
          <div class="flex items-center gap-2 mt-4">
            <span class="sample-label"><i data-lucide="alert-circle" class="w-3 h-3"></i> DEMONSTRATION ONLY</span>
            <span class="text-[10px] text-neutral-500">Not connected to live financial records</span>
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <button id="exportCsv" class="btn btn-secondary">
            <i data-lucide="download" class="w-4 h-4"></i>
            Export CSV
          </button>
          <button id="scrollToSettings" class="btn btn-primary">
            <i data-lucide="settings-2" class="w-4 h-4"></i>
            UPI Settings
          </button>
        </div>
      </section>

      <section aria-label="Sample payment metrics" class="mb-7">
        <div class="flex items-center justify-between mb-3">
          <h2 class="section-title">Collections Overview</h2>
          <span class="text-[10px] text-neutral-500">Illustrative sample figures</span>
        </div>
        <div class="kpi-grid grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
          <article class="panel kpi-card">
            <div class="flex items-start justify-between gap-2">
              <div class="text-[11px] text-neutral-400">Total Collections</div>
              <div class="kpi-icon bg-[#332014] text-[#FF984B]"><i data-lucide="indian-rupee" class="w-5 h-5"></i></div>
            </div>
            <div id="kpiCollections" class="kpi-value mt-4">₹0</div>
            <div class="flex items-center gap-1.5 mt-3 text-[10px] text-neutral-500">
              <i data-lucide="chart-no-axes-combined" class="w-3.5 h-3.5 text-brand"></i>
              Paid transactions only
            </div>
          </article>
          <article class="panel kpi-card">
            <div class="flex items-start justify-between gap-2">
              <div class="text-[11px] text-neutral-400">Successful Payments</div>
              <div class="kpi-icon bg-[#122B20] text-emerald-400"><i data-lucide="check-circle-2" class="w-5 h-5"></i></div>
            </div>
            <div id="kpiSuccessful" class="kpi-value mt-4">0</div>
            <div class="flex items-center gap-1.5 mt-3 text-[10px] text-neutral-500">
              <i data-lucide="badge-check" class="w-3.5 h-3.5 text-emerald-400"></i>
              Transactions marked Paid
            </div>
          </article>
          <article class="panel kpi-card">
            <div class="flex items-start justify-between gap-2">
              <div class="text-[11px] text-neutral-400">Pending Payments</div>
              <div class="kpi-icon bg-[#30270E] text-amber-300"><i data-lucide="clock-3" class="w-5 h-5"></i></div>
            </div>
            <div id="kpiPending" class="kpi-value mt-4">0</div>
            <div class="flex items-center gap-1.5 mt-3 text-[10px] text-neutral-500">
              <i data-lucide="circle-dashed" class="w-3.5 h-3.5 text-amber-300"></i>
              Includes refund pending
            </div>
          </article>
          <article class="panel kpi-card">
            <div class="flex items-start justify-between gap-2">
              <div class="text-[11px] text-neutral-400">Refunds</div>
              <div class="kpi-icon bg-[#241A35] text-purple-300"><i data-lucide="rotate-ccw" class="w-5 h-5"></i></div>
            </div>
            <div id="kpiRefunds" class="kpi-value mt-4">₹0</div>
            <div class="flex items-center gap-1.5 mt-3 text-[10px] text-neutral-500">
              <i data-lucide="info" class="w-3.5 h-3.5 text-purple-300"></i>
              Marked refunded in demo
            </div>
          </article>
        </div>
      </section>

      <section id="upiSettings" class="panel p-5 sm:p-6 mb-7 scroll-mt-24">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-6">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#332014] text-brand grid place-items-center flex-shrink-0">
              <i data-lucide="qr-code" class="w-5 h-5"></i>
            </div>
            <div>
