          <p class="text-[10px] text-[#E3C5A5] leading-relaxed">Demo mode: changes remain in this page's memory and are lost when you reload. No UPI credentials are sent or saved to a server. Only upload a QR code you are authorized to use.</p>
        </div>

        <form id="upiForm" novalidate>
          <div class="grid grid-cols-1 lg:grid-cols-[1fr_270px] gap-7">
            <div class="space-y-5">
              <div>
                <label class="field-label" for="accountHolder">Account Holder / Gym Name <span class="text-brand">*</span></label>
                <input id="accountHolder" name="accountHolder" class="field" type="text" maxlength="100" autocomplete="organization" placeholder="e.g. IronCore Fitness" required aria-describedby="holderError" />
                <p id="holderError" class="text-[10px] text-red-400 mt-1.5 hidden" role="alert"></p>
              </div>
              <div>
                <label class="field-label" for="upiId">Gym Owner's UPI ID <span class="text-brand">*</span></label>
                <input id="upiId" name="upiId" class="field" type="text" maxlength="100" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="name@bank" required aria-describedby="upiError" />
                <p class="text-[10px] text-neutral-600 mt-1.5">Example format only. Enter your own authorized UPI ID; no real details are prefilled.</p>
                <p id="upiError" class="text-[10px] text-red-400 mt-1.5 hidden" role="alert"></p>
              </div>
              <div class="pt-1">
                <div class="flex items-center gap-2 mb-3">
                  <i data-lucide="image-up" class="w-4 h-4 text-brand"></i>
                  <h3 class="text-xs font-semibold">Payment QR Code</h3>
                </div>
                <label for="qrFile" class="field-label">Upload QR image (PNG, JPEG or WebP)</label>
                <input id="qrFile" class="field" type="file" accept="image/png,image/jpeg,image/webp" aria-describedby="qrError" />
                <p id="qrError" class="text-[10px] text-red-400 mt-1.5 hidden" role="alert"></p>
                <p class="text-[10px] text-neutral-600 mt-2">Maximum 2 MB. Preview only; the image is not uploaded anywhere.</p>
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[11px] font-semibold">QR Preview</span>
