            <div>
              <div class="text-[10px] text-neutral-500">Transaction Amount</div>
              <div id="detailAmount" class="heading-font text-3xl mt-2">₹0</div>
            </div>
            <div id="detailStatus"></div>
          </div>
          <div class="border-t border-[#2A2A2A] mt-4 pt-3 flex items-center justify-between gap-3">
            <span class="text-[10px] text-neutral-500">Transaction ID</span>
            <span id="detailId" class="text-[11px] font-semibold break-all text-right">—</span>
          </div>
        </div>
        <h3 class="text-xs font-semibold mb-3">Payment Information</h3>
        <div class="detail-grid">
          <div class="detail-item"><div class="detail-label">Member Name</div><div id="detailMember" class="detail-value">—</div></div>
          <div class="detail-item"><div class="detail-label">Member Email</div><div id="detailEmail" class="detail-value">—</div></div>
          <div class="detail-item"><div class="detail-label">Membership Plan</div><div id="detailPlan" class="detail-value">—</div></div>
          <div class="detail-item"><div class="detail-label">Payment Method</div><div id="detailMethod" class="detail-value">—</div></div>
          <div class="detail-item"><div class="detail-label">Transaction Date</div><div id="detailDate" class="detail-value">—</div></div>
          <div class="detail-item"><div class="detail-label">Member ID</div><div id="detailMemberId" class="detail-value">—</div></div>
          <div class="detail-item"><div class="detail-label">Reference Information</div><div id="detailReference" class="detail-value">—</div></div>
          <div class="detail-item"><div class="detail-label">Record Type</div><div class="detail-value">Illustrative sample</div></div>
        </div>
        <div class="rounded-lg bg-[#211A12] border border-[#49331E] p-3 mt-4 flex gap-2.5 items-start">
          <i data-lucide="info" class="w-4 h-4 text-[#F9B477] mt-0.5 flex-shrink-0"></i>
          <p class="text-[10px] text-[#E3C5A5] leading-relaxed">This record is simulated. Any status update below changes only this page's in-memory dataset; it does not verify or transfer money.</p>
        </div>
        <div class="flex flex-wrap justify-end gap-2 mt-5">
          <button class="btn btn-secondary modal-close" data-close="detailsOverlay">Close</button>
