                <div class="flex items-center gap-2 flex-wrap justify-center">
                  <button type="button" id="replaceQr" class="btn btn-secondary text-[10px]">
                    <i data-lucide="upload" class="w-3.5 h-3.5"></i> Replace
                  </button>
