        <div>
          <div class="eyebrow mb-2">Transaction Record</div>
          <h2 id="detailsTitle" class="heading-font text-2xl tracking-wide">Transaction Details</h2>
          <p id="detailsDescription" class="text-[10px] text-neutral-500 mt-1.5">Illustrative record only. No live gateway data.</p>
        </div>
        <button class="modal-close w-9 h-9 grid place-items-center rounded-lg border border-[#333] text-neutral-400 hover:text-white hover:bg-[#222]" data-close="detailsOverlay" aria-label="Close transaction details">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <div class="p-5 sm:p-6">
        <div class="rounded-xl bg-[#101010] border border-[#2D2D2D] p-4 mb-5">
