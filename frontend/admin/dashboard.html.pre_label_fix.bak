            <thead><tr><th scope="col">Member</th><th scope="col">Plan</th><th scope="col">Join date</th><th scope="col">Status</th></tr></thead>
            <tbody>
              <tr data-searchable="Rahul Premium Today active">
                <td><div class="flex items-center gap-3"><span class="avatar">RS</span><span class="font-semibold">Rahul Sharma</span></div></td>
                <td>Premium</td><td class="text-neutral-400">Today</td><td><span class="status status-active">Active</span></td>
              </tr>
              <tr data-searchable="Aman Basic Today active">
                <td><div class="flex items-center gap-3"><span class="avatar">AS</span><span class="font-semibold">Aman Singh</span></div></td>
                <td>Basic</td><td class="text-neutral-400">Today</td><td><span class="status status-active">Active</span></td>
              </tr>
              <tr data-searchable="Priya Premium Yesterday active">
                <td><div class="flex items-center gap-3"><span class="avatar">PV</span><span class="font-semibold">Priya Verma</span></div></td>
                <td>Premium</td><td class="text-neutral-400">Yesterday</td><td><span class="status status-active">Active</span></td>
              </tr>
            </tbody>
          </table>
          <div id="membersEmpty" class="empty-state" hidden>
            <i data-lucide="search-x"></i><p class="text-xs font-medium">No matching members</p><p class="mt-1 text-[10px]">Try another search term.</p>
          </div>
        </div>
      </section>

      <!-- Footer -->
      <footer class="flex flex-col justify-between gap-2 border-t border-neutral-800 pt-5 text-[10px] text-neutral-600 sm:flex-row sm:items-center">
        <p>© <span id="footerYear">2026</span> <span id="footerGymName">IRONCORE</span> Gym Management. All rights reserved.</p>
        <div class="flex flex-wrap items-center gap-3">
          <span class="flex items-center gap-1.5"><span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span> Demo mode</span>
          <a href="settings.html" class="transition hover:text-neutral-300">Settings</a>
          <span>Frontend preview · No live backend</span>
        </div>
      </footer>
    </div>
  </main>

  <!-- Gym name dialog -->
  <dialog id="gymNameDialog" class="w-[min(420px,calc(100vw-32px))] rounded-xl border border-neutral-700 bg-[#171717] p-0 text-white backdrop:bg-black/70">
    <form id="gymNameForm" class="space-y-5 p-5">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-semibold">Edit gym name</h2>
        <button type="button" id="closeGymDialog" class="grid h-8 w-8 place-items-center rounded-md text-neutral-400 hover:bg-neutral-800" aria-label="Close dialog">
          <i data-lucide="x" class="h-4 w-4"></i>
        </button>
      </div>
      <p class="text-[11px] leading-5 text-neutral-400">Change the name displayed in this dashboard preview. This demo does not save settings to a server.</p>
      <div>
        <label for="gymNameInput" class="mb-2 block text-[11px] font-medium text-neutral-300">Gym name</label>
        <input id="gymNameInput" class="form-control w-full" type="text" maxlength="40" required value="IRONCORE" placeholder="Enter gym name">
      </div>
      <div class="flex justify-end gap-2">
        <button type="button" id="cancelGymDialog" class="action-btn px-4 py-2">Cancel</button>
        <button type="submit" class="action-btn action-primary px-4 py-2">Apply preview</button>
      </div>
    </form>
  </dialog>

  <!-- Demo feedback toast -->
  <div id="toast" class="toast" role="status" aria-live="polite" aria-atomic="true">
    <i data-lucide="info" class="mt-0.5 h-4 w-4 shrink-0 text-accent"></i>
    <div class="min-w-0 flex-1">
      <p id="toastTitle" class="text-xs font-semibold">Demo action</p>
      <p id="toastMessage" class="mt-1 text-[11px] leading-5 text-neutral-400"></p>
    </div>
    <button id="closeToast" class="grid h-7 w-7 shrink-0 place-items-center rounded text-neutral-500 hover:bg-neutral-800 hover:text-white" aria-label="Dismiss notification">
      <i data-lucide="x" class="h-4 w-4"></i>
    </button>
  </div>

  <script>
    'use strict';

    /*
     * FRONTEND DEMO DATA
     * Keep the sample data isolated here so a future integration can replace
     * it with normalized responses from FastAPI/PostgreSQL.
     *
     * Do not use these values as real business records.
     * No fetch calls, credentials, endpoints, or backend writes are used.
     */
    const API_BASE_URL = "http://127.0.0.1:8000";

    function getAuthToken() {
      return sessionStorage.getItem("access_token");
    }

    async function apiRequest(endpoint, options = {}) {
      const token = getAuthToken();

      if (!token) {
        window.location.href = "../public/login.html";
        throw new Error("Login required");
      }

      const response = await fetch(`${API_BASE_URL}${endpoint}`, {
        ...options,
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
          ...options.headers,
        },
      });

      if (response.status === 401) {
        sessionStorage.removeItem("access_token");
        window.location.href = "../public/login.html";
        throw new Error("Session expired. Please log in again.");
      }

      if (!response.ok) {
        const message = await response.text();
        throw new Error(`API error ${response.status}: ${message}`);
      }

      return response.json();
    }







    const DEMO_DATA = {
      revenue: {
        currentMonth: 482500,
        lastMonth: 429800,
        growthPercent: 12.4,
        breakdown: {
          membershipPayments: 245000,
          renewals: 142000,
          newMemberships: 105500,
          refunds: -10000
        },
        periods: {
          '7d': {
            labels: ['03 Oct', '04 Oct', '05 Oct', '06 Oct', '07 Oct', '08 Oct', '09 Oct'],
            membershipPayments: [5200, 6800, 6100, 8200, 7600, 9300, 10400],
            renewals: [3100, 4200, 3500, 4700, 3900, 5300, 5900],
            newMemberships: [1900, 2600, 2300, 3200, 2800, 3700, 4200],
            refunds: [-200, -100, -350, -150, -250, -100, -200]
          },
          '30d': {
            labels: ['10 Sep', '13 Sep', '16 Sep', '19 Sep', '22 Sep', '25 Sep', '28 Sep', '01 Oct', '04 Oct', '07 Oct'],
            membershipPayments: [18000, 21000, 16500, 24000, 22500, 28000, 26000, 31500, 29000, 33000],
            renewals: [10500, 12000, 11500, 13800, 14200, 15500, 14800, 16500, 15900, 18200],
            newMemberships: [7800, 8500, 7300, 9100, 9800, 10200, 9600, 11300, 10800, 12500],
            refunds: [-500, -350, -600, -200, -750, -400, -300, -650, -250, -450]
          },
          '3m': {
            labels: ['Jul W1', 'Jul W3', 'Aug W1', 'Aug W3', 'Sep W1', 'Sep W3'],
            membershipPayments: [155000, 172000, 163000, 185000, 201000, 225000],
            renewals: [85000, 92000, 97000, 104000, 116000, 132000],
            newMemberships: [61000, 65000, 71000, 74000, 86000, 95000],
            refunds: [-4200, -3500, -6100, -4500, -5200, -4000]
          },
          '6m': {
            labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
            membershipPayments: [138000, 151000, 165000, 181000, 207000, 245000],
            renewals: [74000, 81000, 90000, 103000, 120000, 142000],
            newMemberships: [52000, 58000, 66000, 76000, 89000, 105500],
            refunds: [-3200, -4500, -3900, -4800, -6200, -10000]
          },
          '1y': {
            labels: ['Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
            membershipPayments: [112000, 120000, 126000, 130000, 135000, 140000, 138000, 151000, 165000, 181000, 207000, 245000],
            renewals: [58000, 62000, 65000, 69000, 71000, 73000, 74000, 81000, 90000, 103000, 120000, 142000],
            newMemberships: [38000, 41000, 45000, 47000, 50000, 49000, 52000, 58000, 66000, 76000, 89000, 105500],
            refunds: [-2500, -1800, -2900, -2200, -3100, -2700, -3200, -4500, -3900, -4800, -6200, -10000]
          }
        }
      },

      memberships: {
        labels: ['Premium', 'Standard', 'Basic', 'Other'],
        percentages: [42, 35, 18, 5],
        members: [524, 436, 226],
        revenue: [310000, 120000, 42000]
      },

      attendance: {
        labels: ['6 AM', '8 AM', '10 AM', '12 PM', '5 PM', '7 PM', '9 PM'],
        checkIns: [14, 38, 22, 15, 31, 48, 18],
        checkOuts: [4, 16, 13, 11, 21, 29, 18],
        totalCheckIns: 186,
        totalCheckOuts: 112,
        inside: 74,
        capacity: 320,
        peakHour: '7:00 PM'
      },

      members: [
        { name: 'Rahul Sharma', plan: 'Premium', joined: 'Today' },
        { name: 'Aman Singh', plan: 'Basic', joined: 'Today' },
        { name: 'Priya Verma', plan: 'Premium', joined: 'Yesterday' }
      ]
    };

    const currencyFormatter = new Intl.NumberFormat('en-IN', {
      style: 'currency',
      currency: 'INR',
      maximumFractionDigits: 0
    });

    function formatINR(value) {
      return currencyFormatter.format(value);
    }

    function formatCompactINR(value) {
      const abs = Math.abs(value);
      if (abs >= 10000000) return (value / 10000000).toFixed(1) + 'Cr';
      if (abs >= 100000) return (value / 100000).toFixed(1) + 'L';
      if (abs >= 1000) return (value / 1000).toFixed(0) + 'K';
      return String(value);
    }

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, character => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[character]);
    }

    // Initialize Lucide icons with graceful fallback if the CDN is unavailable.
    function initializeIcons() {
      if (window.lucide && typeof window.lucide.createIcons === 'function') {
        window.lucide.createIcons();
      }
    }

    // Date display uses the browser's local date, not a hardcoded current date.
    function initializeDates() {
      const now = new Date();
      document.getElementById('currentDate').textContent = new Intl.DateTimeFormat('en-IN', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
        year: 'numeric'
      }).format(now);

      document.getElementById('copyrightYear').textContent = now.getFullYear();
      document.getElementById('footerYear').textContent = now.getFullYear();
    }

    // Toast feedback is explicit about demo-only behavior.
    let toastTimeout = null;

    function showToast(title, message) {
      const toast = document.getElementById('toast');
      document.getElementById('toastTitle').textContent = title;
      document.getElementById('toastMessage').textContent = message;
      toast.classList.add('show');

      if (toastTimeout) window.clearTimeout(toastTimeout);
      toastTimeout = window.setTimeout(() => {
        toast.classList.remove('show');
      }, 4800);
    }

    function closeToast() {
      document.getElementById('toast').classList.remove('show');
      if (toastTimeout) {
        window.clearTimeout(toastTimeout);
        toastTimeout = null;
      }
    }

    document.getElementById('closeToast').addEventListener('click', closeToast);

    // Responsive sidebar.
    const sidebar = document.getElementById('sidebar');
    const mobileOverlay = document.getElementById('mobileOverlay');
    const openSidebarBtn = document.getElementById('openSidebar');
    const closeSidebarBtn = document.getElementById('closeSidebar');

    function setSidebarOpen(open) {
      sidebar.classList.toggle('open', open);
      mobileOverlay.hidden = !open;
      openSidebarBtn.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';

      if (open) {
        closeSidebarBtn.focus();
      } else if (window.innerWidth < 768) {
        openSidebarBtn.focus();
      }
    }

    openSidebarBtn.addEventListener('click', () => setSidebarOpen(true));
    closeSidebarBtn.addEventListener('click', () => setSidebarOpen(false));
    mobileOverlay.addEventListener('click', () => setSidebarOpen(false));

    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        if (sidebar.classList.contains('open')) setSidebarOpen(false);
        closeDropdowns();
        closeToast();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        sidebar.classList.remove('open');
        mobileOverlay.hidden = true;
        document.body.style.overflow = '';
        openSidebarBtn.setAttribute('aria-expanded', 'false');
      }

      Object.values(charts).forEach(chart => {
        if (chart && typeof chart.resize === 'function') chart.resize();
      });
    });

    // Gym name editing is a local preview only. It is not persisted.
    const gymDialog = document.getElementById('gymNameDialog');
    const gymNameInput = document.getElementById('gymNameInput');

    function openGymNameDialog() {
      gymNameInput.value = document.getElementById('gymNameDisplay').textContent;
      if (typeof gymDialog.showModal === 'function') {
        gymDialog.showModal();
        gymNameInput.focus();
      } else {
        showToast('Unsupported browser', 'This browser does not support the demo name editor.');
      }
    }

    document.getElementById('editGymName').addEventListener('click', openGymNameDialog);

    document.getElementById('closeGymDialog').addEventListener('click', () => gymDialog.close());
    document.getElementById('cancelGymDialog').addEventListener('click', () => gymDialog.close());

    document.getElementById('gymNameForm').addEventListener('submit', event => {
      event.preventDefault();
      const name = gymNameInput.value.trim();

      if (!name) {
        gymNameInput.focus();
        return;
      }

      document.getElementById('gymNameDisplay').textContent = name;
      document.getElementById('footerGymName').textContent = name;
      gymDialog.close();
      showToast('Preview updated', 'The gym name has been updated in this page only. It has not been saved to a backend.');
    });

    // Dropdowns: notifications and profile.
    const notificationBtn = document.getElementById('notificationBtn');
    const notificationPanel = document.getElementById('notificationPanel');

    function closeDropdowns() {
      notificationPanel.hidden = true;
      notificationBtn.setAttribute('aria-expanded', 'false');
    }

    notificationBtn.addEventListener('click', event => {
      event.stopPropagation();
      const willOpen = notificationPanel.hidden;
      closeDropdowns();
      notificationPanel.hidden = !willOpen;
      notificationBtn.setAttribute('aria-expanded', String(willOpen));
    });

    document.querySelectorAll('.notification-item').forEach(button => {
      button.addEventListener('click', () => {
        closeDropdowns();
        showToast('Illustrative notification', button.dataset.message);
      });
    });

    document.getElementById('profileBtn').addEventListener('click', () => {
      showToast('Demo administrator', 'This is a sample owner profile. Account settings and authentication are not connected.');
    });

    document.addEventListener('click', event => {
      if (!notificationPanel.hidden &&
          !notificationPanel.contains(event.target) &&
          !notificationBtn.contains(event.target)) {
        closeDropdowns();
      }
    });

    // Chart configuration. Chart data is entirely local to this demonstration.
    Chart.defaults.color = '#858585';
    Chart.defaults.font.family = 'Inter, sans-serif';
    Chart.defaults.font.size = 10;
    Chart.defaults.animation.duration = 350;

    const gridColor = 'rgba(255,255,255,0.055)';
    const charts = {
      revenue: null,
      memberships: null,
      attendance: null
    };

    function getRevenueTotal(periodData) {
      const sum = key => periodData[key].reduce((total, value) => total + value, 0);
      return sum('membershipPayments') + sum('renewals') + sum('newMemberships') + sum('refunds');
    }

    function makeRevenueDataset(label, data, color, fill = false) {
      return {
        label,
        data,
        borderColor: color,
        backgroundColor: fill ? color + '20' : color,
        borderWidth: 2,
        pointRadius: data.length > 10 ? 0 : 3,
        pointHoverRadius: 5,
        pointBackgroundColor: color,
        pointBorderColor: '#171717',
        pointBorderWidth: 2,
        tension: 0.35,
        fill,
        spanGaps: false
      };
    }

    function initializeRevenueChart() {
      const canvas = document.getElementById('revenueChart');

      if (!window.Chart || !canvas) {
        document.getElementById('revenueChartSummary').textContent =
          'Chart library unavailable. The revenue figures and category summaries above remain available.';
        return;
      }

      const data = DEMO_DATA.revenue.periods['30d'];

      charts.revenue = new Chart(canvas, {
        type: 'line',
        data: {
          labels: data.labels,
          datasets: [
            makeRevenueDataset('Membership payments', data.membershipPayments, '#FF6B00', true),
            makeRevenueDataset('Renewals', data.renewals, '#60A5FA'),
            makeRevenueDataset('New memberships', data.newMemberships, '#4ADE80'),
            makeRevenueDataset('Refunds', data.refunds, '#F87171')
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#222222',
              titleColor: '#FFFFFF',
              bodyColor: '#D4D4D4',
              borderColor: '#414141',
              borderWidth: 1,
              padding: 12,
              callbacks: {
                label: context => `${context.dataset.label}: ${formatINR(context.parsed.y)}`
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 8 }
            },
            y: {
              beginAtZero: true,
              grid: { color: gridColor },
              border: { display: false },
              ticks: {
                maxTicksLimit: 6,
                callback: value => formatCompactINR(value)
              }
            }
          }
        }
      });
    }

    const periodLabels = {
      '7d': 'last 7 days',
      '30d': 'last 30 days',
      '3m': 'last 3 months',
      '6m': 'last 6 months',
      '1y': 'last 1 year'
    };

    function updateRevenueChart(period) {
      const data = DEMO_DATA.revenue.periods[period];

      if (!data || !charts.revenue) return;

      charts.revenue.data.labels = data.labels;
      charts.revenue.data.datasets[0].data = data.membershipPayments;
      charts.revenue.data.datasets[1].data = data.renewals;
      charts.revenue.data.datasets[2].data = data.newMemberships;
      charts.revenue.data.datasets[3].data = data.refunds;
      charts.revenue.data.datasets.forEach(dataset => {
        dataset.pointRadius = data.labels.length > 10 ? 0 : 3;
      });
      charts.revenue.update();

      const total = getRevenueTotal(data);
      document.getElementById('selectedRevenue').textContent = formatINR(total);
      document.getElementById('revenueChartSummary').textContent =
        `Showing illustrative revenue for the ${periodLabels[period]}. Net sample total: ${formatINR(total)}. Values are in Indian rupees.`;

      document.querySelectorAll('[data-period]').forEach(button => {
        const active = button.dataset.period === period;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    document.querySelectorAll('[data-period]').forEach(button => {
      button.addEventListener('click', () => updateRevenueChart(button.dataset.period));
    });

    function initializeMembershipChart() {
      const canvas = document.getElementById('membershipChart');

      if (!window.Chart || !canvas) return;

      charts.memberships = new Chart(canvas, {
        type: 'doughnut',
        data: {
          labels: DEMO_DATA.memberships.labels,
          datasets: [{
            data: DEMO_DATA.memberships.percentages,
            backgroundColor: ['#FF6B00', '#60A5FA', '#4ADE80', '#C084FC'],
            borderColor: '#171717',
            borderWidth: 4,
            hoverOffset: 5,
            spacing: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '77%',
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#222222',
              titleColor: '#FFFFFF',
              bodyColor: '#D4D4D4',
              borderColor: '#414141',
              borderWidth: 1,
              padding: 10,
              callbacks: {
                label: context => `${context.label}: ${context.parsed}%`
              }
            }
          }
        }
      });
    }

    function initializeAttendanceChart() {
      const canvas = document.getElementById('attendanceChart');

      if (!window.Chart || !canvas) {
        document.getElementById('attendanceSummary').textContent =
          'Chart library unavailable. Attendance figures above remain available as illustrative text.';
        return;
      }

      charts.attendance = new Chart(canvas, {
        type: 'bar',
        data: {
          labels: DEMO_DATA.attendance.labels,
          datasets: [{
            label: 'Check-ins',
            data: DEMO_DATA.attendance.checkIns,
            backgroundColor: [
              'rgba(255,107,0,0.60)',
              'rgba(255,107,0,0.70)',
              'rgba(255,107,0,0.65)',
              'rgba(255,107,0,0.55)',
              'rgba(255,107,0,0.78)',
              '#FF6B00',
              'rgba(255,107,0,0.60)'
            ],
            hoverBackgroundColor: '#FF8A38',
            borderRadius: 5,
            borderSkipped: false,
            maxBarThickness: 35
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#222222',
              titleColor: '#FFFFFF',
              bodyColor: '#D4D4D4',
              borderColor: '#414141',
              borderWidth: 1,
              callbacks: {
                label: context => `${context.parsed.y} illustrative check-ins`
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              border: { display: false },
              ticks: { maxRotation: 0, autoSkip: false }
            },
            y: {
              beginAtZero: true,
              suggestedMax: 55,
              grid: { color: gridColor },
              border: { display: false },
              ticks: { stepSize: 10, precision: 0 }
            }
          }
        }
      });
    }

    // Search filters demonstration rows on this page; it never queries a backend.
    const searchInput = document.getElementById('globalSearch');
    const searchForm = document.getElementById('searchForm');

    const searchableTables = [
      { table: 'expiryTable', empty: 'expiryEmpty' },
      { table: 'paymentsTable', empty: 'paymentsEmpty' },
      { table: 'membersTable', empty: 'membersEmpty' }
    ];

    function applySearch(query) {
      const normalizedQuery = query.trim().toLocaleLowerCase('en-IN');

      searchableTables.forEach(({ table, empty }) => {
        const tableElement = document.getElementById(table);
        const rows = Array.from(tableElement.querySelectorAll('tbody tr'));
        let visibleRows = 0;

        rows.forEach(row => {
          const searchableText = (row.dataset.searchable || row.textContent).toLocaleLowerCase('en-IN');
          const matches = !normalizedQuery || searchableText.includes(normalizedQuery);
          row.hidden = !matches;
          if (matches) visibleRows++;
        });

        document.getElementById(empty).hidden = visibleRows !== 0;
        tableElement.querySelector('tbody').hidden = visibleRows === 0;
      });
    }

    searchInput.addEventListener('input', () => applySearch(searchInput.value));

    searchForm.addEventListener('submit', event => {
      event.preventDefault();
      applySearch(searchInput.value);

      if (window.innerWidth < 1024) {
        const query = searchInput.value.trim();
        showToast(
          query ? 'Demo search applied' : 'Search cleared',
          query ? `Showing matching sample table rows for "${query}".` : 'All sample table rows are visible.'
        );
      }
    });

    // Expiry action handlers: display safe preview feedback without mutations.
    document.getElementById('expiryTable').addEventListener('click', event => {
      const button = event.target.closest('button[data-action]');
      if (!button) return;

      const member = button.dataset.member;
      const action = button.dataset.action;

      if (action === 'view') {
        showToast(
          `Sample member: ${member}`,
          'This row contains illustrative membership information only. Open Members for the future member detail page; no live profile is available.'
        );
      } else if (action === 'renew') {
        showToast(
          'Renewal demo only',
          `A renewal preview was requested for ${member}. No subscription was renewed, no payment was taken, and no database record was changed.`
        );
      } else if (action === 'remind') {
        showToast(
          'Reminder preview only',
          `A reminder preview was prepared for ${member}. No email, SMS, WhatsApp message, or other notification was sent.`
        );
      }
    });

    // Provide visible feedback for links while keeping normal page navigation.
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 768) setSidebarOpen(false);
      });
    });

    // Chart.js CDN failure: preserve readable summaries and avoid uncaught errors.
    function showChartFallbackIfNeeded() {
      if (window.Chart) return;

      const fallbackMessages = {
        revenueChart: 'Revenue chart is unavailable because the Chart.js library could not load. Revenue summary figures above are illustrative.',
        membershipChart: 'Membership donut chart is unavailable because the Chart.js library could not load. Plan percentages and counts remain visible in the surrounding text and table.',
        attendanceChart: 'Hourly chart is unavailable because the Chart.js library could not load. The attendance totals and hourly data are available in the demonstration configuration.'
      };

      Object.entries(fallbackMessages).forEach(([id, message]) => {
        const canvas = document.getElementById(id);
        if (!canvas) return;

        const fallback = document.createElement('div');
        fallback.className = 'empty-state h-full';
        fallback.setAttribute('role', 'status');

        const icon = document.createElement('span');
        icon.className = 'mb-3 text-accent';
        icon.textContent = '!';
        icon.setAttribute('aria-hidden', 'true');

        const textElement = document.createElement('p');
        textElement.className = 'max-w-sm text-[11px] leading-5';
        textElement.textContent = message;

        fallback.append(icon, textElement);
        canvas.replaceWith(fallback);
      });
    }

    async function loadDashboardSummary() {
      try {
        const data = await apiRequest("/dashboard/summary");

        console.log("Live dashboard summary:", data);

        const setMetric = (id, value) => {
          const element = document.getElementById(id);
          if (element) element.textContent = value;
        };

        const formatINR = (value) =>
          new Intl.NumberFormat("en-IN", {
            style: "currency",
            currency: "INR",
            maximumFractionDigits: 0
          }).format(Number(value || 0));

        setMetric("kpiTotalMembers", data.total_members ?? 0);
        setMetric("kpiActiveMembers", data.active_subscriptions ?? 0);
        setMetric(
          "kpiExpiringSoon",
          data.memberships_expiring_in_7_days ?? 0
        );
        setMetric("kpiVerifiedRevenue", formatINR(data.verified_revenue));
        setMetric("kpiPendingPayments", data.pending_payments ?? 0);
        setMetric("kpiAttendanceToday", data.attendance_today ?? 0);

        return data;
      } catch (error) {
        console.error("Dashboard summary failed:", error);
        showToast("Unable to load live dashboard data.");
        return null;
      }
    }




    function initializeDashboard() {
      initializeDates();
      loadDashboardSummary();
      if (!window.Chart) {
        showChartFallbackIfNeeded();
      } else {
        try {
          initializeRevenueChart();
          initializeMembershipChart();
          initializeAttendanceChart();
        } catch (error) {
          console.error('Dashboard chart initialization failed:', error);
          showToast('Chart unavailable', 'A visualization could not be initialized. Sample figures remain illustrative and no backend data was requested.');
        }
      }

      initializeIcons();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeDashboard, { once: true });
    } else {
      initializeDashboard();
    }
  </script>
</body>
</html>