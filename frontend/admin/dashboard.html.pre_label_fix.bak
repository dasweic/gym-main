
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0A0A0A">
  <meta name="description" content="Premium Gym Owner Admin Dashboard for membership management, revenue analytics, attendance, payments, and expiry alerts.">
  <title>Dashboard | IRONCORE Gym Management</title>

  <!-- External dependencies: Tailwind CSS, Google Fonts, Chart.js, Lucide -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            canvas: '#0A0A0A',
            panel: '#171717',
            accent: '#FF6B00',
            muted: '#A3A3A3',
            line: '#292929'
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Oswald', 'sans-serif']
          }
        }
      }
    };
  </script>

  <style>
    :root {
      color-scheme: dark;
      --bg: #0A0A0A;
      --panel: #171717;
      --accent: #FF6B00;
      --text: #FFFFFF;
      --muted: #A3A3A3;
      --line: #292929;
    }

    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scrollbar-color: #3A3A3A #0A0A0A;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      overflow-x: hidden;
    }

    button, input, select { font: inherit; }

    button, a, input, select {
      -webkit-tap-highlight-color: transparent;
    }

    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    select:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    ::selection {
      color: white;
      background: #B94B00;
    }

    .display-font { font-family: 'Oswald', sans-serif; }

    .sidebar {
      width: 252px;
      background: var(--panel);
      border-right: 1px solid var(--line);
      transition: transform .25s ease;
    }

    .main-content {
      margin-left: 252px;
      min-height: 100vh;
      min-width: 0;
    }

    .surface {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 12px;
    }

    .surface-hover {
      transition: border-color .2s ease, transform .2s ease, background .2s ease;
    }

    .surface-hover:hover {
      border-color: #454545;
      transform: translateY(-2px);
    }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 43px;
      padding: 0 13px;
      border-radius: 7px;
      color: #A3A3A3;
      text-decoration: none;
      font-weight: 500;
      transition: background .2s ease, color .2s ease;
    }

    .nav-link:hover {
      background: #242424;
      color: white;
    }

    .nav-link.active {
      background: rgba(255, 107, 0, .12);
      color: var(--accent);
      box-shadow: inset 3px 0 0 var(--accent);
    }

    .nav-link svg { width: 18px; height: 18px; flex-shrink: 0; }

    .icon-box {
      width: 39px;
      height: 39px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      flex-shrink: 0;
    }

    .icon-box svg { width: 19px; height: 19px; }

    .kpi-value {
      font-family: 'Oswald', sans-serif;
      font-size: clamp(23px, 2vw, 29px);
      line-height: 1.2;
      font-weight: 500;
      letter-spacing: .2px;
      font-variant-numeric: tabular-nums;
    }

    .muted { color: var(--muted); }

    .section-title {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -.2px;
    }

    .section-subtitle {
      margin-top: 4px;
      font-size: 11px;
      color: var(--muted);
    }

    .period-btn {
      border: 1px solid transparent;
      border-radius: 6px;
      padding: 7px 10px;
      white-space: nowrap;
      font-size: 11px;
      color: #A3A3A3;
      transition: all .2s ease;
    }

    .period-btn:hover { color: white; background: #252525; }

    .period-btn.active {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
      font-weight: 600;
    }

    .chart-wrap {
      position: relative;
      width: 100%;
      min-width: 0;
      height: 275px;
    }

    .donut-wrap {
      position: relative;
      height: 220px;
      width: 100%;
      max-width: 280px;
      margin-inline: auto;
    }

    .attendance-chart-wrap {
      position: relative;
      height: 195px;
      width: 100%;
    }

    .status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 5px 9px;
      border-radius: 5px;
      font-size: 10px;
      font-weight: 600;
      white-space: nowrap;
    }

    .status::before {
      content: '';
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: currentColor;
    }

    .status-paid, .status-active {
      color: #4ADE80;
      background: rgba(74, 222, 128, .09);
    }

    .status-pending {
      color: #FBBF24;
      background: rgba(251, 191, 36, .09);
    }

    .status-danger {
      color: #F87171;
      background: rgba(248, 113, 113, .09);
    }

    .status-warning {
      color: #FBBF24;
      background: rgba(251, 191, 36, .09);
    }

    .table-wrap { width: 100%; overflow-x: auto; }

    .data-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      white-space: nowrap;
    }

    .data-table th {
      padding: 12px 16px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .65px;
      color: #888;
      font-weight: 600;
      background: #191919;
    }

    .data-table td {
      padding: 14px 16px;
      border-top: 1px solid #262626;
      font-size: 11px;
      vertical-align: middle;
    }

    .data-table tbody tr { transition: background .15s ease; }
    .data-table tbody tr:hover { background: #202020; }

    .avatar {
      display: grid;
      place-items: center;
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background: #2D241D;
      color: #FFB17C;
      font-weight: 700;
      font-size: 11px;
      flex-shrink: 0;
      border: 1px solid #443024;
    }

    .avatar-lg {
      width: 39px;
      height: 39px;
      font-size: 12px;
    }

    .action-btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 5px;
      min-height: 29px;
      border: 1px solid #353535;
      padding: 5px 8px;
      border-radius: 5px;
      color: #DDD;
      background: #202020;
      font-size: 10px;
      transition: all .2s ease;
    }

    .action-btn:hover {
      background: #303030;
      border-color: #555;
      color: white;
    }

    .action-primary {
      background: rgba(255,107,0,.12);
      border-color: rgba(255,107,0,.35);
      color: #FF9A55;
    }

    .action-primary:hover {
      background: var(--accent);
      color: white;
      border-color: var(--accent);
    }

    .form-control {
      background: #202020;
      border: 1px solid #333;
      border-radius: 7px;
      color: white;
      padding: 9px 11px;
      outline: none;
    }

    .form-control:focus { border-color: var(--accent); }

    .toast {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 100;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      max-width: min(390px, calc(100vw - 32px));
      padding: 15px 17px;
      background: #202020;
      border: 1px solid #414141;
      border-left: 3px solid var(--accent);
      border-radius: 9px;
      box-shadow: 0 16px 50px rgba(0,0,0,.4);
      opacity: 0;
      transform: translateY(12px);
      pointer-events: none;
      transition: opacity .2s ease, transform .2s ease;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .dropdown {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      z-index: 70;
      width: 290px;
      padding: 12px;
      background: #1B1B1B;
      border: 1px solid #353535;
      border-radius: 10px;
      box-shadow: 0 16px 50px rgba(0,0,0,.4);
    }

    .dropdown[hidden] { display: none; }

    .mobile-overlay {
      position: fixed;
      inset: 0;
      z-index: 39;
      background: rgba(0,0,0,.65);
      backdrop-filter: blur(2px);
    }

    .mobile-overlay[hidden] { display: none; }

    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 3px;
      flex-shrink: 0;
    }

    .progress-track {
      width: 100%;
      height: 5px;
      background: #303030;
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      border-radius: inherit;
      background: var(--accent);
    }

    .empty-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 30px 16px;
      text-align: center;
      color: #888;
    }

    .empty-state svg { width: 27px; height: 27px; margin-bottom: 10px; }

    @media (min-width: 1500px) {
      .dashboard-inner { max-width: 1800px; margin-inline: auto; }
    }

    @media (max-width: 1100px) {
      .sidebar { width: 225px; }
      .main-content { margin-left: 225px; }
      .kpi-value { font-size: 25px; }
      .data-table th, .data-table td { padding-inline: 12px; }
    }

    @media (max-width: 767px) {
      .sidebar {
        position: fixed;
        z-index: 40;
        top: 0;
        bottom: 0;
        left: 0;
        width: 270px;
        transform: translateX(-105%);
        box-shadow: 15px 0 50px rgba(0,0,0,.3);
      }

      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; }
      .header-inner { padding-inline: 16px !important; }
      .dashboard-inner { padding: 18px 16px 28px !important; }
      .chart-wrap { height: 245px; }
      .dropdown { right: -40px; width: min(290px, calc(100vw - 32px)); }
      .toast { right: 16px; bottom: 16px; }
    }

    @media (max-width: 420px) {
      .kpi-value { font-size: 23px; }
      .period-btn { padding: 7px 8px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <!--
    IRONCORE GYM ADMIN DASHBOARD
    All member, payment, attendance, and revenue values in this page are
    illustrative demonstration data. No backend API is connected.
    For production, replace DEMO_DATA with validated FastAPI responses.
    Frontend interactions are demonstrations and are not authorization controls.
  -->

  <div id="mobileOverlay" class="mobile-overlay" hidden></div>

  <!-- Sidebar -->
  <aside id="sidebar" class="sidebar fixed inset-y-0 left-0 z-40 flex flex-col" aria-label="Main navigation">
    <div class="flex items-center justify-between gap-3 px-5 py-6">
      <a href="dashboard.html" class="flex items-center gap-3 min-w-0" aria-label="IRONCORE dashboard">
        <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-accent text-white">
          <i data-lucide="dumbbell" class="h-6 w-6"></i>
        </div>
        <div class="min-w-0">
          <p id="gymNameDisplay" class="display-font truncate text-xl font-semibold tracking-wide text-white">IRONCORE</p>
          <p class="mt-0.5 text-[9px] font-semibold uppercase tracking-[2.2px] text-neutral-500">Gym Management</p>
        </div>
      </a>
      <button id="closeSidebar" class="grid h-9 w-9 shrink-0 place-items-center rounded-lg text-neutral-400 hover:bg-neutral-800 md:hidden" aria-label="Close navigation">
        <i data-lucide="x" class="h-5 w-5"></i>
      </button>
    </div>

    <div class="px-5 pb-3">
      <div class="flex items-center gap-2 rounded-md border border-neutral-800 bg-neutral-900 px-3 py-2">
        <span class="h-2 w-2 rounded-full bg-green-400"></span>
        <span class="text-[10px] text-neutral-400">Owner workspace</span>
        <span class="ml-auto text-[9px] font-semibold text-neutral-500">DEMO</span>
      </div>
    </div>

    <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4" aria-label="Dashboard sections">
      <p class="mb-3 px-3 text-[10px] font-semibold uppercase tracking-[1.5px] text-neutral-600">Workspace</p>

      <a href="dashboard.html" class="nav-link active" aria-current="page">
        <i data-lucide="layout-dashboard"></i><span>Dashboard</span>
      </a>
      <a href="members.html" class="nav-link">
        <i data-lucide="users"></i><span>Members</span>
      </a>
      <a href="payments.html" class="nav-link">
        <i data-lucide="wallet"></i><span>Payments</span>
      </a>
      <a href="plans.html" class="nav-link">
        <i data-lucide="layers"></i><span>Membership Plans</span>
      </a>
      <a href="trainers.html" class="nav-link">
        <i data-lucide="user-round-check"></i><span>Trainers</span>
      </a>

      <div class="my-5 border-t border-neutral-800"></div>
      <p class="mb-3 px-3 text-[10px] font-semibold uppercase tracking-[1.5px] text-neutral-600">Preferences</p>

      <a href="settings.html" class="nav-link">
        <i data-lucide="settings-2"></i><span>Settings</span>
      </a>
    </nav>

    <div class="border-t border-neutral-800 p-4">
      <div class="rounded-lg border border-neutral-800 bg-neutral-900 p-3">
        <div class="flex items-center gap-2">
          <i data-lucide="shield-check" class="h-4 w-4 shrink-0 text-accent"></i>
          <span class="text-[11px] font-semibold">Workspace status</span>
        </div>
        <p class="mt-2 text-[10px] leading-5 text-neutral-500">Demo mode · No live data connected.</p>
      </div>
      <button id="editGymName" class="mt-4 flex w-full items-center gap-2 rounded-md px-2 py-2 text-left text-[11px] text-neutral-400 hover:bg-neutral-800 hover:text-white">
        <i data-lucide="pencil" class="h-4 w-4"></i>
        Edit gym name
      </button>
      <p class="mt-2 px-2 text-[10px] text-neutral-600">© <span id="copyrightYear">2026</span> IRONCORE</p>
    </div>
  </aside>

  <!-- Main content -->
  <main class="main-content">
    <!-- Header -->
    <header class="sticky top-0 z-30 border-b border-neutral-800 bg-[#0A0A0A]/95 backdrop-blur-md">
      <div class="header-inner flex min-h-[76px] items-center justify-between gap-4 px-7">
        <div class="flex min-w-0 items-center gap-3">
          <button id="openSidebar" class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-neutral-800 text-neutral-300 hover:bg-neutral-800 md:hidden" aria-label="Open navigation" aria-expanded="false" aria-controls="sidebar">
            <i data-lucide="menu" class="h-5 w-5"></i>
          </button>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h1 class="display-font text-2xl font-medium tracking-wide sm:text-[28px]">Dashboard</h1>
              <span class="hidden rounded border border-neutral-800 px-2 py-1 text-[9px] font-semibold uppercase tracking-wider text-neutral-500 sm:inline-block">Admin</span>
            </div>
            <p id="currentDate" class="mt-1 text-[10px] text-neutral-500">Loading date…</p>
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2 sm:gap-3">
          <form id="searchForm" class="relative hidden lg:block" role="search">
            <label for="globalSearch" class="sr-only">Search dashboard data</label>
            <i data-lucide="search" class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-500"></i>
            <input id="globalSearch" type="search" placeholder="Search members, payments..." autocomplete="off" class="form-control w-[245px] pl-9 pr-3 text-[11px]" aria-describedby="searchHelp">
            <span id="searchHelp" class="sr-only">Search the demonstration tables on this page.</span>
          </form>

          <div class="relative">
            <button id="notificationBtn" class="relative grid h-10 w-10 place-items-center rounded-lg border border-neutral-800 text-neutral-300 hover:bg-neutral-800" aria-label="Notifications" aria-expanded="false" aria-controls="notificationPanel">
              <i data-lucide="bell" class="h-[18px] w-[18px]"></i>
              <span class="absolute right-[9px] top-[8px] h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            </button>
            <div id="notificationPanel" class="dropdown" hidden>
              <div class="flex items-center justify-between border-b border-neutral-800 pb-3">
                <p class="text-xs font-semibold">Notifications</p>
                <span class="text-[10px] text-neutral-500">Demo alerts</span>
              </div>
              <div class="space-y-1 py-2">
                <button class="notification-item flex w-full gap-3 rounded-md p-2 text-left hover:bg-neutral-800" data-message="Rahul Sharma's membership expires in 2 days.">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-red-500/10 text-red-400"><i data-lucide="calendar-clock" class="h-4 w-4"></i></span>
                  <span><span class="block text-[11px] font-medium">Membership expiring</span><span class="mt-1 block text-[10px] text-neutral-500">Rahul Sharma · 2 days left</span></span>
                </button>
                <button class="notification-item flex w-full gap-3 rounded-md p-2 text-left hover:bg-neutral-800" data-message="One illustrative payment is marked pending. No live payment records are connected.">
                  <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-amber-500/10 text-amber-400"><i data-lucide="wallet" class="h-4 w-4"></i></span>
                  <span><span class="block text-[11px] font-medium">Payment pending</span><span class="mt-1 block text-[10px] text-neutral-500">Priya Verma · ₹2,999</span></span>
                </button>
              </div>
              <p class="border-t border-neutral-800 pt-3 text-[10px] text-neutral-600">Illustrative alerts only. No live notifications.</p>
            </div>
          </div>

          <div class="hidden h-8 w-px bg-neutral-800 sm:block"></div>
          <button id="profileBtn" class="flex items-center gap-2 rounded-lg p-1.5 text-left hover:bg-neutral-900" aria-label="Admin profile" title="Demo administrator profile">
            <span class="avatar avatar-lg border-0 bg-[#3D2415] text-accent">AD</span>
            <span class="hidden min-w-0 sm:block">
              <span class="block text-[11px] font-semibold">Admin</span>
              <span class="mt-1 block text-[10px] text-neutral-500">Gym Owner</span>
            </span>
            <i data-lucide="chevron-down" class="hidden h-3.5 w-3.5 text-neutral-500 sm:block"></i>
          </button>
        </div>
      </div>
    </header>

    <div class="dashboard-inner space-y-6 px-7 py-7">
      <!-- Demo notice and page introduction -->
      <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-[11px] font-medium uppercase tracking-[1.8px] text-accent">Performance overview</p>
          <h2 class="mt-2 text-lg font-semibold tracking-tight">Welcome back, Admin <span aria-hidden="true">✦</span></h2>
          <p class="mt-1 text-xs text-neutral-500">Here's an overview of your gym's performance.</p>
        </div>
        <div class="inline-flex w-fit items-center gap-2 rounded-md border border-amber-500/20 bg-amber-500/[0.06] px-3 py-2 text-[10px] text-amber-300" role="status">
          <i data-lucide="info" class="h-3.5 w-3.5 shrink-0"></i>
          Illustrative demo data · Not live
        </div>
      </section>

      <!-- KPI cards -->
      <section aria-labelledby="kpiHeading">
        <div class="mb-3 flex items-center justify-between">
          <h2 id="kpiHeading" class="text-xs font-semibold uppercase tracking-[1.4px] text-neutral-500">Key metrics</h2>
          <span class="text-[10px] text-neutral-600">Sample figures</span>
        </div>

        <div class="grid grid-cols-1 gap-3 min-[420px]:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-6">
          <article class="surface surface-hover p-4">
            <div class="flex items-start justify-between gap-2">
              <span class="text-[11px] text-neutral-400">Total Members</span>
              <span class="icon-box bg-orange-500/10 text-accent"><i data-lucide="users"></i></span>
            </div>
            <p id="kpiTotalMembers" class="kpi-value mt-4">—</p>
            <div class="mt-3 flex items-center gap-1.5 text-[10px]">
              <span class="flex items-center gap-1 text-green-400"><i data-lucide="trending-up" class="h-3 w-3"></i> 8.2%</span>
              <span class="text-neutral-600">vs. previous period</span>
            </div>
          </article>

          <article class="surface surface-hover p-4">
            <div class="flex items-start justify-between gap-2">
              <span class="text-[11px] text-neutral-400">Active Members</span>
              <span class="icon-box bg-green-500/10 text-green-400"><i data-lucide="user-check"></i></span>
            </div>
            <p id="kpiActiveMembers" class="kpi-value mt-4">—</p>
            <div class="mt-3 flex items-center gap-1.5 text-[10px]">
              <span class="flex items-center gap-1 text-green-400"><i data-lucide="trending-up" class="h-3 w-3"></i> 5.6%</span>
              <span class="text-neutral-600">vs. previous period</span>
            </div>
          </article>

          <article class="surface surface-hover p-4">
            <div class="flex items-start justify-between gap-2">
              <span class="text-[11px] text-neutral-400">Expiring Soon</span>
              <span class="icon-box bg-amber-500/10 text-amber-400"><i data-lucide="calendar-clock"></i></span>
            </div>
            <p id="kpiExpiringSoon" class="kpi-value mt-4">—</p>
            <div class="mt-3 flex items-center gap-1.5 text-[10px]">
              <span class="flex items-center gap-1 text-amber-400"><i data-lucide="alert-circle" class="h-3 w-3"></i> Attention</span>
              <span class="text-neutral-600">renewals due</span>
            </div>
